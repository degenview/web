---
import { COFFEE_URL } from '../data/platforms';
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---

<a
  href={COFFEE_URL}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['group inline-flex items-center gap-2 rounded-lg border border-line bg-transparent px-3.5 py-2 text-sm font-semibold text-fg transition-colors hover:border-muted hover:bg-surface', className]}
>
  <svg viewBox="0 0 24 24" class="size-4 text-[#ffdd00] transition-transform group-hover:-rotate-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 10h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5zM17 11h1.500a2.500 2.500 0 0 1 0 5H17M8 3v3M12 3v3" />
  </svg>
  Buy me a coffee<span class="sr-only"> (opens in a new tab)</span>
</a>
