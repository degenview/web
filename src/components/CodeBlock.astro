---
interface Props {
  /** The text to show and copy. */
  code: string;
  /** Shown above the block, e.g. a file name. */
  label?: string;
}
const { code, label } = Astro.props;
---

<div class="min-w-0 max-w-full overflow-hidden rounded-xl border border-line bg-bg">
  <div class="flex items-center justify-between gap-3 border-b border-line/70 bg-chrome/40 px-3 py-1">
    <span class="truncate font-mono text-xs text-muted">{label ?? 'shell'}</span>
    <button type="button" data-copy={code} class="rounded-md px-3 py-2 text-xs font-medium text-muted transition-colors hover:bg-chrome hover:text-fg" aria-label={`Copy ${label ?? 'commands'}`}>Copy</button>
  </div>
  <pre class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-fg"><code>{code}</code></pre>
</div>
