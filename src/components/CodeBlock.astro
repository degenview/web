---
import { fmt, getLang, useT } from '../i18n';
interface Props {
  /** The text to show and copy. */
  code: string;
  /** Shown above the block, e.g. a file name. */
  label?: string;
}
const { code, label } = Astro.props;
const t = useT(getLang(Astro.url)).common.codeBlock;
---

<div class="min-w-0 max-w-full overflow-hidden rounded-lg border border-[var(--hair)] bg-bg">
  <div class="flex items-center justify-between gap-3 border-b border-[var(--hair)] bg-[var(--tile)] px-3 py-1">
    <span class="mono-label truncate">{label ?? t.defaultLabel}</span>
    <button type="button" data-copy={code} class="rounded-md px-3 py-2 font-mono text-[0.68rem] font-medium uppercase tracking-[0.12em] text-muted transition-colors hover:bg-chrome hover:text-fg" aria-label={fmt(t.copyAria, { label: label ?? t.copyAriaFallbackLabel })}>{t.copy}</button>
  </div>
  <pre class="overflow-x-auto p-4 font-mono text-[13px] leading-relaxed text-fg"><code>{code}</code></pre>
</div>
