---
const points = [
  ['No account', 'Nothing to sign up for. Open the app and go.'],
  ['Scripts stay local', 'Your Pine Script source never leaves your device.'],
  ['Keys stay yours', 'Your API keys are stored securely on your device.'],
  ['Open source', 'GPL-3.0. Read it, build it, change it.'],
];
---

<section aria-labelledby="priv-h" class="border-y border-line/50 py-28">
  <div class="container-x">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold text-accent-text">local-first</p>
      <h2 id="priv-h" class="display mt-3 text-4xl sm:text-6xl">Your machine. <span class="gradient-text">Your scripts. Your data.</span></h2>
    </div>
    <dl class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {points.map(([t, d]) => <div class="card p-6"><dt class="text-lg font-semibold">{t}</dt><dd class="mt-2 text-muted">{d}</dd></div>)}
    </dl>
  </div>
</section>
