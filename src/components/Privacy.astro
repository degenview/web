---
const points = [
  ['No account', 'Nothing to sign up for. Open the app and go.'],
  ['Scripts stay local', 'Your Pine Script source never leaves your device.'],
  ['Keys stay yours', 'Your API keys are stored securely on your device.'],
  ['Open source', 'GPL-3.0. Read it, build it, change it.'],
];
---

<section aria-labelledby="priv-h" class="border-y border-line/70 bg-surface/50 py-24">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="font-mono text-sm font-semibold text-accent-text">local-first</p>
      <h2 id="priv-h" class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-5xl">Your machine. Your scripts. Your data.</h2>
    </div>
    <dl class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {points.map(([t, d]) => <div><dt class="font-semibold">{t}</dt><dd class="mt-2 text-muted">{d}</dd></div>)}
    </dl>
  </div>
</section>
