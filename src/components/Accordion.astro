---
// FAQ accordion as a rows panel: native <details>, hairline dividers, mono index in front of every question.
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
const hasFooter = Astro.slots.has('default');
---

<div class:list={['glass divide-y divide-[var(--hair)] overflow-hidden', className]} data-reveal="fade">
  {
    items.map(({ q, a }, i) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-baseline gap-4 px-5 py-4 text-base font-semibold transition-colors hover:bg-[var(--tile)] sm:gap-5 sm:px-7 sm:py-5 sm:text-lg [&::-webkit-details-marker]:hidden">
          <span class="card-index shrink-0">{String(i + 1).padStart(2, '0')}</span>
          <span class="min-w-0 flex-1">{q}</span>
          <svg viewBox="0 0 24 24" class="size-4 shrink-0 translate-y-0.5 self-center text-muted transition-transform group-open:rotate-45 group-open:text-accent-text" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        </summary>
        <p class="px-5 pb-5 text-muted sm:pb-6 sm:pl-[4.75rem] sm:pr-7 sm:text-lg">{a}</p>
      </details>
    ))
  }
  {hasFooter && <div class="bg-[var(--tile)] px-5 py-4 text-sm text-muted sm:px-7"><slot /></div>}
</div>
