---
import { REPO_URL } from '../data/platforms';
import ThemeToggle from './ThemeToggle.astro';
import { getRelease } from '../data/release';
const release = await getRelease();
const year = new Date().getFullYear();
---

<footer class="border-t border-line/50 py-14 text-sm text-muted">
  <div class="container-x flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
    <div class="max-w-md space-y-2">
      <p class="font-semibold text-fg">DegenView</p>
      <p>Free, open-source market dashboard. © {year} Nico Oelgart, GPL-3.0-only.</p>
      <p class="text-xs">Pine Script and TradingView are trademarks of TradingView, Inc. DegenView is not affiliated with or endorsed by TradingView or any listed data provider. All other trademarks belong to their owners. Not financial advice.</p>
    </div>
    <div class="flex flex-col gap-6 sm:items-end">
      <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
        <a class="hover:text-fg" href="/download/">Download</a>
        <a class="hover:text-fg" href="/tradingview-alternative/">TradingView alternative</a>
        <a class="hover:text-fg" href="/faq/">FAQ</a>
        <a class="hover:text-fg" href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a>
        <a class="hover:text-fg" href="/privacy-policy/">Privacy policy</a>
        <button type="button" data-cookie-settings class="hover:text-fg">Cookie settings</button>
      </nav>
      <div class="flex flex-wrap items-center gap-3 sm:justify-end">
        <p class="inline-flex max-w-full flex-wrap items-center gap-x-3 gap-y-1 rounded-md border border-line py-1 pl-1 pr-3 text-sm">
          <span class="rounded bg-chrome px-2 py-0.5 font-mono text-xs font-semibold text-fg" data-dl-version>{release.tag ?? 'Open source'}</span>
          <span>GPL-3.0 · macOS · Windows · Linux</span>
        </p>
        <ThemeToggle />
      </div>
    </div>
  </div>
</footer>
