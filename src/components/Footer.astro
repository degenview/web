---
import { DOCS_URL, REPO_URL } from '../data/platforms';
import ThemeToggle from './ThemeToggle.astro';
import CoffeeButton from './CoffeeButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getRelease } from '../data/release';
import { fmt, getLang, useT, localePath } from '../i18n';
const lang = getLang(Astro.url);
const t = useT(lang).common;
const release = await getRelease();
// Runtime strings for src/scripts/platform.ts (client scripts can't use the dictionary directly).
const dlStrings = JSON.stringify({
  downloadFor: t.download.downloadFor,
  chooseDownload: t.download.chooseDownload,
  mobileNote: t.download.mobileNote,
}).replace(/</g, '\\u003c');
const year = new Date().getFullYear();
---

<footer class="pb-8 pt-4 text-sm text-muted sm:pb-10">
  <div class="container-x">
    <div class="glass p-6 sm:p-8 lg:p-10">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">
        <div class="max-w-md space-y-3">
          <p class="font-display text-3xl font-extrabold uppercase leading-none tracking-[0.03em] text-fg">DegenView</p>
          <p>{fmt(t.footer.tagline, { year })}</p>
          <p class="text-xs leading-relaxed text-muted/80">{t.footer.trademark}</p>
        </div>
        <nav aria-label={t.nav.footer} class="grid grid-cols-2 gap-x-6 lg:col-span-2 lg:grid-cols-2">
          <ul class="space-y-0.5">
            <li><a class="inline-block py-1.5 transition-colors hover:text-fg" href={localePath(lang, '/download/')}>{t.nav.download}</a></li>
            <li><a class="inline-block py-1.5 transition-colors hover:text-fg" href={localePath(lang, '/pine-studio/')}>{t.nav.pineStudio}</a></li>
            <li><a class="inline-block py-1.5 transition-colors hover:text-fg" href={localePath(lang, '/tradingview-alternative/')}>{t.nav.tradingviewAlternative}</a></li>
            <li><a class="inline-block py-1.5 transition-colors hover:text-fg" href={localePath(lang, '/faq/')}>{t.nav.faq}</a></li>
          </ul>
          <ul class="space-y-0.5">
            <li><a class="inline-block py-1.5 transition-colors hover:text-fg" href={DOCS_URL}>{t.nav.docs}</a></li>
            <li><a class="inline-block py-1.5 transition-colors hover:text-fg" href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> {t.opensInNewTab}</span></a></li>
            <li><a class="inline-block py-1.5 transition-colors hover:text-fg" href={localePath(lang, '/privacy-policy/')}>{t.nav.privacyPolicy}</a></li>
            <li><button type="button" data-cookie-settings class="inline-block py-1.5 text-left transition-colors hover:text-fg">{t.nav.cookieSettings}</button></li>
          </ul>
        </nav>
      </div>
      <div class="mt-8 flex flex-col gap-4 border-t border-[var(--hair)] pt-6 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
        <p class="inline-flex max-w-full flex-wrap items-center gap-x-3 gap-y-1">
          <span class="tag !text-fg" data-dl-version>{release.tag ?? t.footer.versionFallback}</span>
          <span class="mono-label">GPL-3.0 · macOS · Windows · Linux</span>
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <LanguageSwitcher up align="auto" />
          <ThemeToggle />
          <CoffeeButton />
        </div>
      </div>
    </div>
  </div>
</footer>
<script is:inline type="application/json" id="dv-i18n" set:html={dlStrings}></script>
