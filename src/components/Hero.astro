---
import DownloadButton from './DownloadButton.astro';
import PreReleaseNote from './PreReleaseNote.astro';
import Screenshot from './Screenshot.astro';
---

<section class="relative overflow-hidden pb-24 pt-16 sm:pt-24">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute left-1/2 top-[-12rem] h-[34rem] w-[60rem] -translate-x-1/2 rounded-full blur-3xl" style="background: radial-gradient(closest-side, var(--glow-a), transparent)"></div>
    <div class="absolute right-[-12rem] top-72 h-[30rem] w-[40rem] rounded-full blur-3xl" style="background: radial-gradient(closest-side, var(--glow-b), transparent)"></div>
    <svg class="absolute inset-0 size-full [mask-image:radial-gradient(ellipse_at_top,black,transparent_65%)]" aria-hidden="true">
      <defs><pattern id="g" width="56" height="56" patternUnits="userSpaceOnUse"><path d="M56 0H0V56" fill="none" stroke="var(--grid)" /></pattern></defs>
      <rect width="100%" height="100%" fill="url(#g)" />
    </svg>
  </div>

  <div class="container-x relative z-10 text-center">
    <p class="mx-auto mb-6 inline-flex rounded-full border border-line bg-surface/60 px-4 py-1.5 text-sm font-medium text-muted backdrop-blur">Free &amp; open source <a href="/tradingview-alternative/" class="ml-1 font-semibold text-accent-text hover:underline">TradingView alternative</a></p>
    <h1 class="display mx-auto max-w-5xl text-5xl sm:text-7xl lg:text-8xl">
      Where <em class="italic">multiple watchlists</em> is <span class="gradient-text block">not a premium feature.</span>
    </h1>
    <p class="mx-auto mt-8 max-w-2xl text-balance text-lg text-muted sm:text-xl">
      The free, open source TradingView alternative for your desktop: crypto, stocks and prediction markets in
      multi-chart layouts, with local Pine Script, alerts and replay. No account, and it runs on your machine.
    </p>
    <div class="mt-10 flex flex-col items-center gap-4">
      <DownloadButton showNote github />
      <PreReleaseNote variant="inline" />
    </div>
  </div>

  <div class="container-x mt-20 max-w-5xl">
    <Screenshot slug="hero" alt="DegenView dashboard with multiple live charts in a grid layout" priority framed sizes="(min-width: 1088px) 1024px, calc(100vw - 2rem)" />
  </div>
</section>
