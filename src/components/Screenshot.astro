---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  alt: string;
  priority?: boolean;
  class?: string;
  /** The image is a full window shot with its own title bar and rounded, transparent corners: skip the site's card frame. */
  framed?: boolean;
  /** Responsive `sizes` hint; defaults to the two-column feature layout. */
  sizes?: string;
}
const {
  slug, alt, priority = false, class: className = '',
  framed = false, sizes = '(min-width: 1024px) 720px, 100vw',
} = Astro.props;

// Screenshots are optional: drop `<slug>-dark.png` / `<slug>-light.png` into src/assets/screens/.
const shots = import.meta.glob<{ default: ImageMetadata }>('/src/assets/screens/*.{png,jpg,jpeg,webp}', { eager: true });
const find = (variant: string) =>
  Object.entries(shots).find(([path]) => new RegExp(`/${slug}-${variant}\\.(png|jpe?g|webp)$`).test(path))?.[1].default;

const dark = find('dark');
const light = find('light') ?? dark;
const darkImg = dark ?? light;
// Never upscale: cap the width ladder at the source image's own width.
const ladder = (img?: ImageMetadata) => (img ? [...new Set([...[640, 960, 1280, 1920].filter((w) => w < img.width), img.width])] : []);
const quality = 90;

// Optional screen recording: `<slug>.mp4` replaces the screenshot, `<slug>-poster.webp` is the still shown before it plays.
const clips = import.meta.glob<string>('/src/assets/screens/*.mp4', { eager: true, query: '?url', import: 'default' });
const clip = Object.entries(clips).find(([path]) => path.endsWith(`/${slug}.mp4`))?.[1];
const posterSrc = Object.entries(shots).find(([path]) => path.endsWith(`/${slug}-poster.webp`))?.[1].default;
const poster = clip && posterSrc ? await getImage({ src: posterSrc, width: Math.min(1280, posterSrc.width), quality }) : undefined;
---

<figure class:list={['window', framed ? 'shot-framed' : 'card shot-glow overflow-hidden', className]}>
  {
    clip ? (
      <>
        <button type="button" data-shot-open class="group/clip relative block w-full cursor-zoom-in" aria-label={`${alt}. Open larger player`}>
          <video
            data-shot-video
            class="block h-auto w-full"
            src={clip}
            data-poster={poster?.src}
            width={posterSrc?.width}
            height={posterSrc?.height}
            muted
            loop
            playsinline
            preload="metadata"
            aria-hidden="true"
          />
          <span class="pointer-events-none absolute bottom-3 right-3 grid size-9 place-items-center rounded-lg bg-black/60 text-white opacity-0 backdrop-blur transition-opacity group-hover/clip:opacity-100 group-focus-visible/clip:opacity-100" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
          </span>
        </button>
        <dialog data-shot-dialog class="m-auto w-[min(96vw,1600px)] max-w-none overflow-visible bg-transparent p-0 backdrop:bg-black/85 backdrop:backdrop-blur-sm" aria-label={alt}>
          <div class="relative">
            <video data-shot-big class="block h-auto max-h-[88vh] w-full rounded-xl bg-black object-contain shadow-2xl" data-poster={poster?.src} controls loop playsinline preload="none"></video>
            <button type="button" data-shot-close class="absolute right-2 top-2 grid size-10 place-items-center rounded-lg bg-black/60 text-white backdrop-blur hover:bg-black/80" aria-label="Close player">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          </div>
        </dialog>
        <figcaption class="sr-only">{alt}</figcaption>
      </>
    ) : darkImg && light ? (
      <>
        <button type="button" data-shot-open class="group/clip relative block w-full cursor-zoom-in" aria-label={`${alt}. Enlarge image`}>
          <Image src={light} alt="" widths={ladder(light)} sizes={sizes} quality={quality} class="shot-light block h-auto w-full"
            loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding={priority ? 'sync' : 'async'} />
          <Image src={darkImg} alt="" widths={ladder(darkImg)} sizes={sizes} quality={quality} class="shot-dark h-auto w-full"
            loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding={priority ? 'sync' : 'async'} />
          <span class="pointer-events-none absolute bottom-3 right-3 grid size-9 place-items-center rounded-lg bg-black/60 text-white opacity-0 backdrop-blur transition-opacity group-hover/clip:opacity-100 group-focus-visible/clip:opacity-100" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
          </span>
        </button>
        <dialog data-shot-dialog class="m-auto w-fit max-w-[96vw] overflow-visible bg-transparent p-0 backdrop:bg-black/85 backdrop:backdrop-blur-sm" aria-label={alt}>
          <div class="relative">
            <Image src={light} alt={alt} widths={ladder(light)} sizes="96vw" quality={quality} loading="lazy"
              class:list={['shot-light block h-auto max-h-[88vh] w-auto max-w-[96vw] drop-shadow-2xl', !framed && 'rounded-xl']} />
            <Image src={darkImg} alt={alt} widths={ladder(darkImg)} sizes="96vw" quality={quality} loading="lazy"
              class:list={['shot-dark h-auto max-h-[88vh] w-auto max-w-[96vw] drop-shadow-2xl', !framed && 'rounded-xl']} />
            <button type="button" data-shot-close class="absolute right-2 top-2 grid size-10 place-items-center rounded-lg bg-black/60 text-white backdrop-blur hover:bg-black/80" aria-label="Close image">
              <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          </div>
        </dialog>
      </>
    ) : (
      <div class="relative grid aspect-[16/10] place-items-center bg-bg" role="img" aria-label={`${alt} (screenshot coming soon)`}>
        <svg class="absolute inset-0 size-full opacity-60" viewBox="0 0 160 100" preserveAspectRatio="none" aria-hidden="true">
          <g fill="none" stroke="var(--grid)" stroke-width="0.3">
            {Array.from({ length: 9 }, (_, i) => <path d={`M0 ${(i + 1) * 10}H160`} />)}
            {Array.from({ length: 15 }, (_, i) => <path d={`M${(i + 1) * 10} 0V100`} />)}
          </g>
          <path d="M0 78 L18 66 L34 72 L52 50 L70 58 L90 34 L110 42 L130 20 L160 28" fill="none" stroke="var(--accent)" stroke-width="0.8" stroke-linejoin="round" />
        </svg>
        <span class="relative rounded-full border border-line bg-surface px-4 py-1.5 font-mono text-xs text-muted">screenshot coming soon</span>
      </div>
    )
  }
</figure>

<script>
  // Clicking a screenshot or clip opens it large in a <dialog>. Clips also autoplay inline while visible
  // (never for reduced-motion users) and carry their playback position into the larger player.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const inView = new WeakMap<HTMLVideoElement, boolean>();
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      inView.set(v, e.isIntersecting);
      if (e.isIntersecting && !v.closest('figure')?.querySelector('dialog')?.open) v.play().catch(() => {});
      else v.pause();
    }),
    { threshold: 0.25 },
  );

  // Posters of clips further down the page load shortly before they scroll into view, not with the page.
  const posterIO = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const v = e.target as HTMLVideoElement;
      if (v.dataset.poster) v.poster = v.dataset.poster;
      posterIO.unobserve(v);
    }),
    { rootMargin: '900px 0px' },
  );

  document.querySelectorAll<HTMLElement>('figure:has([data-shot-open])').forEach((fig) => {
    const dialog = fig.querySelector<HTMLDialogElement>('dialog[data-shot-dialog]')!;
    const small = fig.querySelector<HTMLVideoElement>('video[data-shot-video]');
    const big = fig.querySelector<HTMLVideoElement>('video[data-shot-big]');
    if (small) posterIO.observe(small);
    if (small && !reduce) io.observe(small);

    fig.querySelector('[data-shot-open]')!.addEventListener('click', () => {
      if (small && big) {
        if (!big.poster && big.dataset.poster) big.poster = big.dataset.poster;
        if (!big.src) big.src = small.currentSrc || small.src;
        big.currentTime = small.currentTime;
        small.pause();
      }
      dialog.showModal();
      if (big && !reduce) big.play().catch(() => {});
    });
    fig.querySelector('[data-shot-close]')!.addEventListener('click', () => dialog.close());
    // Click on the dim backdrop (outside the media) closes it too.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      if (!small || !big) return;
      big.pause();
      small.currentTime = big.currentTime;
      if (!reduce && inView.get(small)) small.play().catch(() => {});
    });
  });
</script>
