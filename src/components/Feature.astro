---
import Screenshot from './Screenshot.astro';
import type { Feature } from '../data/features';
interface Props { feature: Feature; flip?: boolean }
const { feature: f, flip = false } = Astro.props;
---

<article id={f.slug} class="grid items-center gap-10 py-14 lg:grid-cols-2 lg:gap-16 lg:py-24">
  <div class:list={[flip && 'lg:order-2']}>
    <p class="text-sm font-semibold text-accent-text">{f.eyebrow}</p>
    <h3 class="display mt-3 text-3xl sm:text-5xl">{f.title}</h3>
    <p class="mt-5 text-lg text-muted">{f.blurb}</p>
    <ul class="mt-7 space-y-3">
      {
        f.bullets.map((b) => (
          <li class="flex gap-3">
            <svg viewBox="0 0 24 24" class="mt-1 size-5 shrink-0 text-accent-text" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
            <span class="text-fg/90">{b}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <Screenshot slug={f.slug} alt={f.alt} framed={f.framed} class={flip ? 'lg:order-1' : ''} />
</article>
