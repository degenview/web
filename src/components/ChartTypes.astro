---
/**
 * One example per chart type, drawn at build time from the same synthetic price series, so the tiles
 * differ only in how they draw it. Names and groups mirror the app's chart type picker.
 */
type Bar = { o: number; h: number; l: number; c: number; v: number };

// Small seeded PRNG: the same series on every build.
function rng(seed: number) {
  return () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// 120 "ticks" of a choppy uptrend with a pullback in the middle.
const rand = rng(42);
const ticks: number[] = [];
let price = 100;
for (let i = 0; i < 120; i++) {
  const drift = i < 40 ? 0.35 : i < 70 ? -0.3 : 0.4;
  price += drift + (rand() - 0.5) * 3.2;
  ticks.push(price);
}

// Time bars: five ticks each.
const bars: Bar[] = [];
for (let i = 0; i < ticks.length; i += 5) {
  const s = ticks.slice(i, i + 5);
  bars.push({ o: s[0], h: Math.max(...s) + rand() * 0.8, l: Math.min(...s) - rand() * 0.8, c: s[s.length - 1], v: 0.35 + rand() });
}

const X0 = 6, X1 = 154, Y0 = 8, Y1 = 92;
const f = (n: number) => +n.toFixed(2);
const UP = 'var(--up)', DOWN = 'var(--down)', LINE = 'var(--accent)';

function scaler(values: number[], pad = 0.06) {
  const lo = Math.min(...values), hi = Math.max(...values), span = hi - lo || 1;
  return (v: number) => f(Y1 - ((v - lo + span * pad) / (span * (1 + pad * 2))) * (Y1 - Y0));
}

function candleSvg(list: Bar[], opts: { hollow?: boolean; volume?: boolean } = {}) {
  const y = scaler(list.flatMap((b) => [b.h, b.l]));
  const step = (X1 - X0) / list.length, maxV = Math.max(...list.map((b) => b.v));
  return list.map((b, i) => {
    const cx = X0 + step * (i + 0.5), up = b.c >= b.o, col = up ? UP : DOWN;
    const w = opts.volume ? step * (0.25 + (0.7 * b.v) / maxV) : step * 0.62;
    const top = y(Math.max(b.o, b.c)), h = Math.max(0.8, y(Math.min(b.o, b.c)) - top);
    const fill = opts.hollow && up ? 'var(--bg)' : col;
    return `<line x1="${f(cx)}" x2="${f(cx)}" y1="${y(b.h)}" y2="${y(b.l)}" stroke="${col}" stroke-width="1"/><rect x="${f(cx - w / 2)}" y="${top}" width="${f(w)}" height="${f(h)}" fill="${fill}" stroke="${col}" stroke-width="${opts.hollow ? 1 : 0.4}"/>`;
  }).join('');
}

function ohlcBars(list: Bar[], highLow = false) {
  const y = scaler(list.flatMap((b) => [b.h, b.l]));
  const step = (X1 - X0) / list.length;
  return list.map((b, i) => {
    const cx = X0 + step * (i + 0.5), col = b.c >= b.o ? UP : DOWN, w = step * 0.36;
    if (highLow) return `<rect x="${f(cx - step * 0.22)}" y="${y(b.h)}" width="${f(step * 0.44)}" height="${f(Math.max(1, y(b.l) - y(b.h)))}" fill="${col}"/>`;
    return `<path d="M${f(cx)} ${y(b.h)}V${y(b.l)}M${f(cx - w)} ${y(b.o)}H${f(cx)}M${f(cx)} ${y(b.c)}H${f(cx + w)}" stroke="${col}" stroke-width="1.2" fill="none"/>`;
  }).join('');
}

function heikinAshi(list: Bar[]): Bar[] {
  const out: Bar[] = [];
  list.forEach((b, i) => {
    const c = (b.o + b.h + b.l + b.c) / 4;
    const o = i === 0 ? (b.o + b.c) / 2 : (out[i - 1].o + out[i - 1].c) / 2;
    out.push({ o, c, h: Math.max(b.h, o, c), l: Math.min(b.l, o, c), v: b.v });
  });
  return out;
}

// Lines and areas work on the bar closes.
const closes = bars.map((b) => b.c);
const cy = scaler(closes);
const cstep = (X1 - X0) / bars.length;
const pts = closes.map((c, i) => [f(X0 + cstep * (i + 0.5)), cy(c)] as const);
const linePath = 'M' + pts.map(([x, yy]) => `${x} ${yy}`).join('L');
const lineEl = (extra = '') => `<path d="${linePath}" fill="none" stroke="${LINE}" stroke-width="1.6" stroke-linejoin="round" ${extra}/>`;
const areaTo = (base: number) => `${linePath}L${pts[pts.length - 1][0]} ${base}L${pts[0][0]} ${base}Z`;

function stepLine() {
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) d += `H${pts[i][0]}V${pts[i][1]}`;
  return `<path d="${d}" fill="none" stroke="${LINE}" stroke-width="1.6"/>`;
}

function hlcArea() {
  const y = scaler(bars.flatMap((b) => [b.h, b.l]));
  const hi = bars.map((b, i) => `${f(X0 + cstep * (i + 0.5))} ${y(b.h)}`);
  const lo = bars.map((b, i) => `${f(X0 + cstep * (i + 0.5))} ${y(b.l)}`).reverse();
  const cl = 'M' + bars.map((b, i) => `${f(X0 + cstep * (i + 0.5))} ${y(b.c)}`).join('L');
  return `<path d="M${hi.join('L')}L${lo.join('L')}Z" fill="${LINE}" fill-opacity=".2"/><path d="${cl}" fill="none" stroke="${LINE}" stroke-width="1.6" stroke-linejoin="round"/>`;
}

function baseline() {
  const mid = cy((Math.min(...closes) + Math.max(...closes)) / 2);
  return `<defs><clipPath id="ct-bl-up"><rect x="0" y="0" width="160" height="${mid}"/></clipPath><clipPath id="ct-bl-dn"><rect x="0" y="${mid}" width="160" height="100"/></clipPath></defs>`
    + `<path d="${linePath}L${pts[pts.length - 1][0]} ${mid}L${pts[0][0]} ${mid}Z" fill="${UP}" fill-opacity=".28" clip-path="url(#ct-bl-up)"/>`
    + `<path d="${linePath}L${pts[pts.length - 1][0]} ${mid}L${pts[0][0]} ${mid}Z" fill="${DOWN}" fill-opacity=".28" clip-path="url(#ct-bl-dn)"/>`
    + `<path d="${linePath}" fill="none" stroke="${UP}" stroke-width="1.6" clip-path="url(#ct-bl-up)"/><path d="${linePath}" fill="none" stroke="${DOWN}" stroke-width="1.6" clip-path="url(#ct-bl-dn)"/>`
    + `<line x1="${X0}" x2="${X1}" y1="${mid}" y2="${mid}" stroke="var(--muted)" stroke-width=".6" stroke-dasharray="2 2"/>`;
}

function columns() {
  const lo = Math.min(...closes), hi = Math.max(...closes), span = hi - lo;
  return closes.map((c, i) => {
    const h = 6 + ((c - lo) / span) * (Y1 - Y0 - 8);
    const col = c >= (closes[i - 1] ?? c) ? UP : DOWN;
    return `<rect x="${f(X0 + cstep * i + cstep * 0.17)}" y="${f(Y1 - h)}" width="${f(cstep * 0.66)}" height="${f(h)}" fill="${col}"/>`;
  }).join('');
}

// Price-based types ignore time and work on the raw ticks.
const tickMin = Math.min(...ticks), tickMax = Math.max(...ticks), tickRange = tickMax - tickMin;

// Renko, Kagi, Line Break and Point & Figure only move on reversals, so they get a livelier series
// (swings plus drift) to have something to show.
const waveRand = rng(7);
const wave: number[] = [];
for (let i = 0; i < 300; i++) wave.push(100 + 13 * Math.sin(i / 17) + 5 * Math.sin(i / 6.5) + i * 0.1 + (waveRand() - 0.5) * 3);
const waveMin = Math.min(...wave), waveMax = Math.max(...wave), waveRange = waveMax - waveMin;

function renko() {
  let best: { o: number; c: number }[] = [];
  for (let k = 8; k <= 22; k++) {
    const B = waveRange / k;
    const list: { o: number; c: number }[] = [];
    let lo = wave[0], hi = wave[0];
    for (const p of wave) {
      while (p >= hi + B) { list.push({ o: hi, c: hi + B }); lo = hi; hi += B; }
      while (p <= lo - B) { list.push({ o: lo, c: lo - B }); hi = lo; lo -= B; }
    }
    if (!best.length || Math.abs(list.length - 18) < Math.abs(best.length - 18)) best = list;
  }
  const y = scaler(best.flatMap((b) => [b.o, b.c]), 0.04);
  const step = (X1 - X0) / best.length;
  return best.map((b, i) => {
    const top = y(Math.max(b.o, b.c)), h = y(Math.min(b.o, b.c)) - top;
    return `<rect x="${f(X0 + step * i + 0.4)}" y="${f(top + 0.4)}" width="${f(step - 0.8)}" height="${f(Math.max(0.8, h - 0.8))}" fill="${b.c > b.o ? UP : DOWN}"/>`;
  }).join('');
}

function kagi() {
  const R = waveRange / 14;
  type Seg = { x: number; from: number; to: number };
  const segs: Seg[] = [];
  let dir = 0, anchor = wave[0], ext = wave[0];
  for (const p of wave) {
    if (dir === 0) { if (Math.abs(p - anchor) >= R) { dir = p > anchor ? 1 : -1; ext = p; segs.push({ x: 0, from: anchor, to: p }); } continue; }
    if (dir === 1) {
      if (p > ext) { ext = p; segs[segs.length - 1].to = p; }
      else if (ext - p >= R) { dir = -1; segs.push({ x: segs.length, from: ext, to: p }); ext = p; }
    } else if (p < ext) { ext = p; segs[segs.length - 1].to = p; }
    else if (p - ext >= R) { dir = 1; segs.push({ x: segs.length, from: ext, to: p }); ext = p; }
  }
  segs.forEach((s, i) => (s.x = i));
  const y = scaler(segs.flatMap((s) => [s.from, s.to]));
  const step = (X1 - X0) / segs.length;
  let thick = true, prevHigh = -Infinity, prevLow = Infinity;
  return segs.map((s, i) => {
    const cx = f(X0 + step * (i + 0.5));
    const up = s.to > s.from;
    if (up && s.to > prevHigh) thick = true;
    if (!up && s.to < prevLow) thick = false;
    if (up) prevLow = Math.min(prevLow, s.from); else prevHigh = Math.max(prevHigh, s.from);
    const nx = f(X0 + step * (i + 1.5));
    const link = i < segs.length - 1 ? `<path d="M${cx} ${y(s.to)}H${nx}" stroke="${thick ? UP : DOWN}" stroke-width="${thick ? 2.4 : 1.1}" fill="none"/>` : '';
    return `<path d="M${cx} ${y(s.from)}V${y(s.to)}" stroke="${thick ? UP : DOWN}" stroke-width="${thick ? 2.4 : 1.1}" fill="none"/>${link}`;
  }).join('');
}

function lineBreak() {
  type L = { o: number; c: number };
  const lines: L[] = [];
  let last = wave[0];
  for (const p of wave) {
    if (!lines.length) { if (p !== last) { lines.push({ o: last, c: p }); } continue; }
    const L0 = lines[lines.length - 1], upLine = L0.c > L0.o;
    const recent = lines.slice(-3), lo3 = Math.min(...recent.flatMap((l) => [l.o, l.c])), hi3 = Math.max(...recent.flatMap((l) => [l.o, l.c]));
    if (upLine) {
      if (p > L0.c) lines.push({ o: L0.c, c: p });
      else if (p < lo3) lines.push({ o: L0.o, c: p });
    } else if (p < L0.c) lines.push({ o: L0.c, c: p });
    else if (p > hi3) lines.push({ o: L0.o, c: p });
  }
  const list = lines.slice(-20);
  const y = scaler(list.flatMap((l) => [l.o, l.c]), 0.04);
  const step = (X1 - X0) / list.length;
  return list.map((l, i) => {
    const top = y(Math.max(l.o, l.c)), h = y(Math.min(l.o, l.c)) - top;
    return `<rect x="${f(X0 + step * i + 0.4)}" y="${f(top)}" width="${f(step - 0.8)}" height="${f(Math.max(0.8, h))}" fill="${l.c > l.o ? UP : DOWN}"/>`;
  }).join('');
}

function pointAndFigure() {
  const box = waveRange / 15;
  type C = { x: boolean; lo: number; hi: number };
  const idx = (p: number) => Math.floor((p - waveMin) / box);
  const cols: C[] = [{ x: true, lo: idx(wave[0]), hi: idx(wave[0]) }];
  for (const p of wave) {
    const b = idx(p), c = cols[cols.length - 1];
    if (c.x) {
      if (b > c.hi) c.hi = b;
      else if (b <= c.hi - 3) cols.push({ x: false, hi: c.hi - 1, lo: b });
    } else if (b < c.lo) c.lo = b;
    else if (b >= c.lo + 3) cols.push({ x: true, lo: c.lo + 1, hi: b });
  }
  const lo = Math.min(...cols.map((c) => c.lo)), hi = Math.max(...cols.map((c) => c.hi));
  const rows = hi - lo + 1;
  const cw = Math.min((X1 - X0) / cols.length, 11), ch = (Y1 - Y0) / rows;
  const ox = X0 + ((X1 - X0) - cw * cols.length) / 2;
  let out = '';
  cols.forEach((c, i) => {
    for (let b = c.lo; b <= c.hi; b++) {
      const cx = ox + cw * (i + 0.5), cy2 = Y1 - ch * (b - lo + 0.5), r = Math.min(cw, ch) * 0.36;
      out += c.x
        ? `<path d="M${f(cx - r)} ${f(cy2 - r)}L${f(cx + r)} ${f(cy2 + r)}M${f(cx + r)} ${f(cy2 - r)}L${f(cx - r)} ${f(cy2 + r)}" stroke="${UP}" stroke-width="1" fill="none"/>`
        : `<circle cx="${f(cx)}" cy="${f(cy2)}" r="${f(r)}" stroke="${DOWN}" stroke-width="1" fill="none"/>`;
    }
  });
  return out;
}

function rangeBars() {
  const R = tickRange / 10;
  const list: Bar[] = [];
  let cur = { o: ticks[0], h: ticks[0], l: ticks[0] };
  for (const p of ticks) {
    cur.h = Math.max(cur.h, p); cur.l = Math.min(cur.l, p);
    if (cur.h - cur.l >= R) {
      let c: number;
      if (p >= cur.h) { cur.h = cur.l + R; c = cur.h; } else { cur.l = cur.h - R; c = cur.l; }
      list.push({ ...cur, c, v: 1 });
      cur = { o: c, h: c, l: c };
    }
  }
  return candleSvg(list.slice(-22));
}

// Display order follows the app's picker: standard, lines & areas, price-based.
const raw: [string, string, string][] = [
  ['Candles', 'The classic: open, high, low and close in one body-and-wick shape.', candleSvg(bars)],
  ['Hollow Candles', 'Rising candles are hollow and falling ones are filled, so momentum reads at a glance.', candleSvg(bars, { hollow: true })],
  ['Bars', 'A vertical range line with a tick for the open on the left and the close on the right.', ohlcBars(bars)],
  ['High-Low Bars', 'Each bar spans just the high to the low. Pure range, no opinions about the close.', ohlcBars(bars, true)],
  ['Volume Candles', 'Candles whose width grows with traded volume, so the heavy bars stand out.', candleSvg(bars, { volume: true })],
  ['Heikin Ashi', 'Averaged candles that smooth out the noise and make trends easier to follow.', candleSvg(heikinAshi(bars))],
  ['Line', 'Closing prices joined into one clean line.', lineEl()],
  ['Line with Markers', 'The same line, with a dot on every close.', lineEl() + pts.map(([x, yy]) => `<circle cx="${x}" cy="${yy}" r="1.7" fill="var(--bg)" stroke="${LINE}" stroke-width="1"/>`).join('')],
  ['Step Line', 'Holds each close flat until the next one, so you see exactly when price changed.', stepLine()],
  ['Area', 'A line with everything below it filled in.', `<path d="${areaTo(Y1)}" fill="${LINE}" fill-opacity=".22"/>` + lineEl()],
  ['HLC Area', 'The high-low range as a band around the closing line.', hlcArea()],
  ['Baseline', 'Green above a reference level, red below it.', baseline()],
  ['Columns', 'Closing prices as bars from the bottom, tinted by direction.', columns()],
  ['Renko', 'Fixed-size bricks that only appear when price moves far enough. No move, no brick.', renko()],
  ['Kagi', 'Vertical lines joined by short steps, switching direction only on a meaningful reversal.', kagi()],
  ['Line Break', 'A new block forms only when price breaks the recent range, which filters out the noise.', lineBreak()],
  ['Point & Figure', 'Columns of Xs and Os for rising and falling prices, with no time axis at all.', pointAndFigure()],
  ['Range', 'Every bar covers the same price range, so a quiet market simply draws fewer bars.', rangeBars()],
];
// Stroke widths follow --sw, so the big display can draw thinner lines than the 160-unit canvas implies.
const items = raw.map(([name, desc, svg]) => ({
  name, desc,
  svg: svg.replace(/stroke-width="([\d.]+)"/g, (_m, n) => `style="stroke-width:calc(${n}*var(--sw,1))"`),
}));
---

<section id="chart-types" aria-labelledby="ct-h" class="border-t border-line/50 py-16 sm:py-24">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-accent-text">chart types</p>
      <h2 id="ct-h" class="display mt-3 text-4xl sm:text-6xl">Candles are <span class="gradient-text">just the start</span></h2>
      <p class="mt-5 text-lg text-muted">{items.length} chart types, all one click away. Pick your poison.</p>
    </div>

    <div data-chart-types class="relative mt-14 overflow-hidden rounded-3xl border border-line bg-bg">
      <div class="grid lg:grid-cols-[5fr_7fr]">
        <div data-ct-viewport class="relative h-[19rem] overflow-hidden px-6 sm:px-12 lg:h-[27rem] [mask-image:linear-gradient(to_bottom,transparent,black_14%,black_86%,transparent)]">
          <ul data-ct-list class="transition-transform duration-500 ease-out will-change-transform">
            {
              items.map((it, i) => (
                <li data-ct-item data-active={i === 0 ? '' : undefined} class="group">
                  <button type="button" data-ct-select={i} class="flex h-[4.25rem] w-full items-center text-left" aria-current={i === 0 ? 'true' : undefined}>
                    <span class="display whitespace-nowrap text-3xl text-fg/45 transition-colors duration-300 group-hover:text-fg/60 group-data-[active]:text-fg sm:text-4xl">{it.name}</span>
                  </button>
                  <div class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-500 group-data-[active]:grid-rows-[1fr] group-data-[active]:opacity-100">
                    <div class="overflow-hidden"><p class="pb-4 text-base text-muted sm:text-lg">{it.desc}</p></div>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="relative aspect-[16/10] lg:aspect-auto">
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,var(--glow-a),transparent_65%)] opacity-60"></div>
          {
            items.map((it, i) => (
              <svg
                data-ct-art viewBox="0 0 160 100" preserveAspectRatio="xMidYMid meet" role="img" aria-label={`${it.name} chart example`}
                data-active={i === 0 ? '' : undefined}
                style="--sw:.5"
                class="absolute inset-0 size-full p-6 pb-16 opacity-0 transition-opacity duration-700 data-[active]:opacity-100 lg:p-14 lg:pb-14 [filter:drop-shadow(0_0_7px_rgb(34_171_148/.45))_drop-shadow(0_0_7px_rgb(247_82_95/.3))]"
                set:html={it.svg}
              />
            ))
          }
        </div>
      </div>

      <div class="absolute bottom-4 right-4 flex items-center gap-1 text-fg sm:bottom-6 sm:right-6">
        <button type="button" data-ct-prev class="grid size-9 place-items-center rounded-lg hover:bg-chrome" aria-label="Previous chart type">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
        </button>
        <span class="min-w-[4.5rem] text-center font-mono text-sm tabular-nums" aria-live="off"><span data-ct-count>1</span> / {items.length}</span>
        <button type="button" data-ct-next class="grid size-9 place-items-center rounded-lg hover:bg-chrome" aria-label="Next chart type">
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
        </button>
        <button type="button" data-ct-play class="ml-2 grid size-9 place-items-center rounded-lg bg-chrome hover:bg-border" aria-label="Pause autoplay" aria-pressed="true">
          <svg data-ct-icon-pause viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
          <svg data-ct-icon-play viewBox="0 0 24 24" class="hidden size-4" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  // The list slides so the active type sits near the top with its description open; the chart crossfades.
  const root = document.querySelector<HTMLElement>('[data-chart-types]');
  if (root) {
    const viewport = root.querySelector<HTMLElement>('[data-ct-viewport]')!;
    const list = root.querySelector<HTMLElement>('[data-ct-list]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-ct-item]')];
    const arts = [...root.querySelectorAll<SVGElement>('[data-ct-art]')];
    const count = root.querySelector<HTMLElement>('[data-ct-count]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-ct-play]')!;
    const iconPause = root.querySelector<SVGElement>('[data-ct-icon-pause]')!;
    const iconPlay = root.querySelector<SVGElement>('[data-ct-icon-play]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const INTERVAL = 4500;
    let idx = 0, playing = !reduce, visible = false, timer = 0;

    const show = (i: number) => {
      idx = (i + rows.length) % rows.length;
      rows.forEach((r, n) => {
        r.toggleAttribute('data-active', n === idx);
        r.querySelector('button')!.setAttribute('aria-current', String(n === idx));
      });
      arts.forEach((a, n) => a.toggleAttribute('data-active', n === idx));
      count.textContent = String(idx + 1);
      // Rows above the active one are collapsed, so its final top is idx * row height.
      const row = rows[0].querySelector('button')!.offsetHeight;
      list.style.transform = `translateY(${Math.round(viewport.clientHeight * 0.2 - idx * row)}px)`;
    };
    const stop = () => { clearInterval(timer); timer = 0; };
    const start = () => { stop(); if (playing && visible) timer = window.setInterval(() => show(idx + 1), INTERVAL); };
    const setPlaying = (on: boolean) => {
      playing = on;
      iconPause.classList.toggle('hidden', !on);
      iconPlay.classList.toggle('hidden', on);
      playBtn.setAttribute('aria-pressed', String(on));
      playBtn.setAttribute('aria-label', on ? 'Pause autoplay' : 'Start autoplay');
      start();
    };

    rows.forEach((r, n) => r.querySelector('button')!.addEventListener('click', () => { show(n); start(); }));
    root.querySelector('[data-ct-prev]')!.addEventListener('click', () => { show(idx - 1); start(); });
    root.querySelector('[data-ct-next]')!.addEventListener('click', () => { show(idx + 1); start(); });
    playBtn.addEventListener('click', () => setPlaying(!playing));
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; start(); }, { threshold: 0.35 }).observe(root);
    addEventListener('resize', () => show(idx));
    setPlaying(playing);
    show(0);
  }
</script>
