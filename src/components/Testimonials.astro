---
// "What people are saying": one featured quote and three smaller ones. The quotes are verbatim (src/data/testimonials.ts),
// so they stay in their original language on every locale and are marked lang="en"; only the labels are translated.
import SectionHead from './SectionHead.astro';
import { testimonials } from '../data/testimonials';
import { getLang, useT } from '../i18n';

const t = useT(getLang(Astro.url)).home.testimonials;

// Split a quote around its highlighted phrase: [before, highlight, after].
const parts = (q: string, hl?: string): [string, string, string] => {
  const i = hl ? q.indexOf(hl) : -1;
  return i < 0 ? [q, '', ''] : [q.slice(0, i), hl as string, q.slice(i + (hl as string).length)];
};
---

<section id="feedback" aria-labelledby="feedback-h" class="py-16 sm:py-24">
  <div class="container-x">
    <SectionHead id="feedback-h" eyebrow={t.eyebrow} title={t.heading} />

    {/* The reveal sits on the <li>, with the hover glow on the card inside. */}
    <ul class="mt-10 grid gap-4 sm:mt-12 sm:gap-6 lg:grid-cols-5">
      {
        testimonials.map((q, i) => {
          const [before, hl, after] = parts(q.quote, q.highlight);
          return (
            <li data-reveal style={`--i:${i}`} class:list={['flex', q.featured ? 'lg:col-span-3 lg:row-span-3' : 'lg:col-span-2']}>
              <figure class:list={['card relative flex w-full flex-col overflow-hidden', q.featured && 'stage']}>
                {q.featured && <span class="glow-line absolute inset-x-10 top-0" aria-hidden="true"></span>}
                {/* Oversized quote mark as a watermark. */}
                <svg viewBox="0 0 24 24" aria-hidden="true" class:list={['pointer-events-none absolute fill-current text-accent-text', q.featured ? '-right-6 -top-8 size-72 opacity-[.07]' : '-right-4 -top-5 size-36 opacity-[.07]']}>
                  <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z" />
                </svg>

                <div class:list={['relative flex items-center justify-between gap-3', q.featured ? 'p-6 pb-0 sm:p-8 sm:pb-0 lg:p-10 lg:pb-0' : 'p-5 pb-0 sm:p-6 sm:pb-0']}>
                  <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
                  <span class="tag">{t.tags[q.tag]}</span>
                </div>

                <blockquote lang="en" class:list={['relative flex-1', q.featured ? 'p-6 sm:p-8 lg:flex lg:flex-col lg:justify-center lg:p-10 lg:pt-8' : 'p-5 sm:p-6']}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" class:list={['mb-4 fill-current text-accent-text drop-shadow-[0_0_12px_color-mix(in_oklab,var(--accent)_60%,transparent)]', q.featured ? 'size-9 sm:size-11' : 'size-7']}>
                    <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z" />
                  </svg>
                  <p class:list={['font-medium text-fg', q.featured ? 'text-2xl leading-snug tracking-tight sm:text-3xl lg:text-[2.1rem] lg:leading-[1.2]' : 'text-lg leading-snug tracking-tight sm:text-xl']}>
                    {before}{hl && <span class="gradient-text">{hl}</span>}{after}
                  </p>
                </blockquote>

                <figcaption class:list={['relative flex items-center gap-3 border-t border-[var(--hair)]', q.featured ? 'px-6 py-4 sm:px-8 lg:px-10' : 'px-5 py-3.5 sm:px-6']}>
                  <span aria-hidden="true" class="size-1.5 shrink-0 rounded-[1px] bg-accent-text shadow-[0_0_8px_1px_color-mix(in_oklab,var(--accent)_65%,transparent)]"></span>
                  <span class="mono-label">{t.author}</span>
                </figcaption>
              </figure>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
