---
import { notPremium, altTaglines } from '../data/features';
---

<section aria-label="Features that are free here and premium elsewhere">
  <div>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        notPremium.map((f) => (
          <li class="card flex flex-col gap-2 p-5">
            <span class="font-semibold">{f.name}</span>
            <span class="flex items-center gap-2 font-mono text-xs">
              <s class="text-down" aria-label="Premium on other apps">Premium</s>
              <span aria-hidden="true">→</span>
              <b class="text-accent-text">Free</b>
            </span>
            {f.note && <span class="text-xs text-muted">{f.note}</span>}
          </li>
        ))
      }
    </ul>
    <ul class="mt-10 flex flex-wrap justify-center gap-2.5" aria-label="More ways to put it">
      {altTaglines.map((t) => <li class="rounded-full border border-line bg-surface px-4 py-2 text-sm text-muted">{t}</li>)}
    </ul>
  </div>
</section>
