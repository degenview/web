---
// Shown while the newest release is a pre-release or release candidate, and gone once a stable one ships.
import { getRelease } from '../data/release';
import { REPO_URL } from '../data/platforms';
interface Props { variant?: 'block' | 'inline'; class?: string }
const { variant = 'block', class: className = '' } = Astro.props;

const release = await getRelease();
const pre = !!release.tag && (/-(rc|beta|alpha)\b/.test(release.tag) || release.prerelease === true);
const what = release.tag && /-rc\b/.test(release.tag) ? 'release candidate' : 'pre-release';
const warn = 'M12 9v4m0 4h.01M10.3 3.9 2.4 17.5A2 2 0 0 0 4.1 20.5h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z';
---

{
  pre && variant === 'block' && (
    <aside class:list={['mx-auto flex max-w-2xl items-start gap-4 rounded-2xl border border-[#f5a524]/40 bg-[#f5a524]/[0.07] p-5 text-left', className]} aria-label="Pre-release notice">
      <svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0 text-[#f5a524]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={warn} /></svg>
      <div>
        <p class="font-semibold">DegenView is in {what} testing</p>
        <p class="mt-1 text-sm text-muted">
          <span class="font-mono text-fg" data-dl-version>{release.tag}</span> is a {what} of the next stable version, so you may hit rough edges. Found one?{' '}
          <a class="font-medium text-accent-text underline underline-offset-4" href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer">Tell us on GitHub<span class="sr-only"> (opens in a new tab)</span></a>.
          <a class="ml-1 font-medium text-accent-text underline underline-offset-4" href={release.htmlUrl} target="_blank" rel="noopener noreferrer">Release notes<span class="sr-only"> (opens in a new tab)</span></a>
        </p>
      </div>
    </aside>
  )
}
{
  pre && variant === 'inline' && (
    <p class:list={['mx-auto flex max-w-xl items-start justify-center gap-2 text-sm text-muted', className]}>
      <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-[#f5a524]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={warn} /></svg>
      <span>
        This is a {what}, so expect some rough edges.{' '}
        <a class="font-medium text-accent-text underline underline-offset-4" href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer">Report issues on GitHub<span class="sr-only"> (opens in a new tab)</span></a>.
      </span>
    </p>
  )
}
