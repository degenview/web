---
import SectionHead from './SectionHead.astro';
import { getExtras } from '../data/features';
import { getArt } from '../data/illustrations';
import { getLang, useT, fmt } from '../i18n';

const lang = getLang(Astro.url);
const t = useT(lang).home.extras;
const extras = getExtras(lang);
const art = getArt(lang);
const notes = extras.filter((e) => e.note).map((e) => e.note as string);
---

<section id="more" aria-labelledby="more-h" class="py-16 sm:py-24">
  <div class="container-x">
    <SectionHead id="more-h" align="left" eyebrow={t.eyebrow} title={t.heading} lead={t.intro} />

    {/* Numbered tool cards: index and tag on top, illustration, then title and text. The reveal sits on the <li>, the hover on the card inside. */}
    <ul class="mt-10 grid gap-4 sm:mt-12 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
      {
        extras.map((e, i) => (
          <li data-reveal style={`--i:${i % 4}`} class="flex">
            <div class="card card-hover flex w-full flex-col overflow-hidden">
              <div class="flex items-center justify-between gap-3 px-5 pt-5 sm:px-6 sm:pt-6">
                <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="tag">{e.tag}</span>
              </div>
              <div class="relative mt-4 aspect-[16/10] border-y border-[var(--hair)] bg-bg/50">
                <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,var(--glow-a),transparent_70%)]"></div>
                <svg viewBox="0 0 320 200" class="absolute inset-0 size-full" role="img" aria-label={fmt(t.illustrationAria, { title: e.title.replace(/\*$/, '') })} set:html={art[e.slug]} />
              </div>
              <div class="p-5 sm:p-6">
                <h3 class="display text-2xl sm:text-[1.7rem]">{e.title}</h3>
                <p class="mt-3 text-sm text-fg/70 sm:text-base">{e.text}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    {notes.length > 0 && <div class="mt-6 space-y-1 border-t border-[var(--hair)] pt-5 font-mono text-xs leading-relaxed text-muted" data-reveal="fade">{notes.map((n) => <p>* {n}</p>)}</div>}
  </div>
</section>
