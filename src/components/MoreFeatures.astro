---
import { extras } from '../data/features';
import { art } from '../data/illustrations';
const notes = extras.filter((e) => e.note).map((e) => e.note as string);

---

<section id="more" aria-labelledby="more-h" class="py-24">
  <div class="container-x flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold text-accent-text">and while you’re here</p>
      <h2 id="more-h" class="display mt-3 text-4xl sm:text-6xl">The rest of the <span class="gradient-text">good stuff</span></h2>
      <p class="mt-5 text-lg text-muted">Not every feature earns a screenshot. These earned an illustration.</p>
    </div>
    <div class="flex gap-2" data-more-nav>
      <button type="button" data-more-prev class="grid size-11 place-items-center rounded-full border border-line hover:border-muted disabled:opacity-30 disabled:hover:border-line" aria-label="Scroll back">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
      </button>
      <button type="button" data-more-next class="grid size-11 place-items-center rounded-full border border-line hover:border-muted disabled:opacity-30 disabled:hover:border-line" aria-label="Scroll forward">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
      </button>
    </div>
  </div>

  <ul
    data-more-track
    class="mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    style="padding-inline:max(1rem,calc((100vw - 72rem)/2));scroll-padding-inline:max(1rem,calc((100vw - 72rem)/2))"
  >
    {
      extras.map((e) => (
        <li class="card w-[min(21rem,84vw)] shrink-0 snap-start overflow-hidden">
          <div class="relative aspect-[16/10] border-b border-line bg-bg">
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,var(--glow-a),transparent_70%)]"></div>
            <svg viewBox="0 0 320 200" class="absolute inset-0 size-full" role="img" aria-label={`${e.title.replace(/\*$/, '')} illustration`} set:html={art[e.slug]} />
          </div>
          <div class="p-6">
            <h3 class="display text-2xl">{e.title}</h3>
            <p class="mt-3 text-muted">{e.text}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="container-x">
    {notes.map((n) => <p class="mt-4 max-w-3xl text-sm text-muted">* {n}</p>)}
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-more-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-more-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-more-next]');
  if (track && prev && next) {
    const step = () => (track.firstElementChild as HTMLElement).offsetWidth + 16;
    const sync = () => {
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    // Start on the second card; the first sits just off the left edge, one tap on the back arrow away.
    track.scrollLeft = step();
    sync();
  }
</script>
