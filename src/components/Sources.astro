---
import { Image } from 'astro:assets';
import binance from '../assets/sources/binance.svg';
import coinbase from '../assets/sources/coinbase.svg';
import okx from '../assets/sources/okx.svg';
import kraken from '../assets/sources/kraken.svg';
import bybit from '../assets/sources/bybit.svg';
import gateio from '../assets/sources/gateio.svg';
import mexc from '../assets/sources/mexc.svg';
import coingecko from '../assets/sources/coingecko.png';
import dexscreener from '../assets/sources/dexscreener.png';
import polymarket from '../assets/sources/polymarket.png';
import kalshi from '../assets/sources/kalshi.png';
import cmc from '../assets/sources/coinmarketcap.svg';
import alpaca from '../assets/sources/alpaca.png';
import { getLang, useT } from '../i18n';

const t = useT(getLang(Astro.url)).home.sources;

const sources = [
  { name: 'Binance', img: binance }, { name: 'Coinbase', img: coinbase }, { name: 'OKX', img: okx },
  { name: 'Kraken', img: kraken }, { name: 'Bybit', img: bybit }, { name: 'Gate.io', img: gateio },
  { name: 'MEXC', img: mexc }, { name: 'CoinGecko', img: coingecko }, { name: 'DEXScreener', img: dexscreener },
  { name: 'Polymarket', img: polymarket }, { name: 'Kalshi', img: kalshi }, { name: 'CoinMarketCap', img: cmc },
  { name: 'Alpaca', img: alpaca },
];
---

<section aria-labelledby="sources-h" class="pt-6 sm:pt-8">
  <div class="container-x">
    <div class="glass flex flex-col gap-5 p-6 sm:p-8 lg:flex-row lg:items-center lg:gap-10 lg:py-6 lg:pl-10 lg:pr-6" data-reveal>
      <h2 id="sources-h" class="kicker shrink-0 lg:max-w-[13rem]">{t.heading}</h2>
      {/* Infinite marquee, right to left. The list is rendered twice and the track slides by exactly one copy
          (-50%), so the loop is seamless at any width. The second copy is hidden from assistive tech. */}
      <div class="marquee min-w-0 flex-1">
        <div class="marquee-track">
          {
            [false, true].map((dup) => (
              <ul class="marquee-group" aria-hidden={dup ? 'true' : undefined}>
                {sources.map((s) => (
                  <li class="source">
                    <Image src={s.img} alt="" width={28} height={28} class="size-6 shrink-0 rounded object-contain" loading="lazy" />
                    <span>{s.name}</span>
                  </li>
                ))}
              </ul>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    /* Fade the ends so logos glide in and out instead of being clipped. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 48s linear infinite;
    will-change: transform;
  }
  .marquee-group {
    display: flex;
    flex-shrink: 0;
    gap: 0.625rem;
    /* Trailing gap keeps the spacing between the two copies equal to the spacing inside a copy. */
    padding-inline-end: 0.625rem;
  }
  .source {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 1rem 0.5rem 0.625rem;
    border: 1px solid var(--hair);
    border-radius: 9999px;
    background: var(--tile);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    color: color-mix(in srgb, currentColor 85%, transparent);
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }
  .source:hover {
    border-color: var(--hair-hi);
    color: currentColor;
  }
  @media (hover: hover) {
    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }
  }
  @keyframes marquee {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }
  /* No motion: drop the duplicate and the fade, and let the logos wrap as a static list. */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee-track {
      width: auto;
      animation: none;
    }
    .marquee-group {
      flex-wrap: wrap;
      padding-inline-end: 0;
    }
    .marquee-group[aria-hidden='true'] {
      display: none;
    }
  }
</style>
