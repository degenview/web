---
import { DOCS_URL, REDDIT_URL, REPO_URL } from '../data/platforms';
import PlatformIcon from './PlatformIcon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLang, useT, localePath, stripLocale } from '../i18n';

const lang = getLang(Astro.url);
const t = useT(lang).common;
// /404/ is shared by every language, so nothing is "current" there.
const here = Astro.url.pathname === '/404/' ? '' : stripLocale(Astro.url.pathname);
const item = (path: string, label: string) => ({ href: localePath(lang, path), label, current: path === here });
const links = [
  item('/#features', t.nav.features),
  item('/pine-studio/', t.nav.pineStudio),
  item('/tradingview-alternative/', t.nav.tradingviewAlternative),
  { href: DOCS_URL, label: t.nav.docs, current: false },
];
const download = item('/download/', t.nav.download);
---

<header data-site-header class="sticky top-0 z-40 border-b border-[var(--hair)] bg-bg/90">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href={localePath(lang, '/')} class="flex items-center gap-2.5" aria-label={t.nav.homeAria}>
      <span class="font-display text-[1.7rem] font-extrabold leading-none tracking-[0.03em]">DegenView</span>
    </a>
    <nav aria-label={t.nav.primary} class="hidden items-center gap-0.5 whitespace-nowrap text-sm font-medium lg:flex">
      {links.map((l) => (
        <a class="rounded-lg px-2.5 py-2 text-fg/75 transition-colors hover:bg-fg/[0.06] hover:text-fg aria-[current=page]:bg-fg/[0.08] aria-[current=page]:text-fg xl:px-3.5" href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="inline-flex items-center gap-2 rounded-lg px-2.5 py-2 text-fg/75 transition-colors hover:bg-fg/[0.06] hover:text-fg xl:px-3.5" href={REPO_URL} target="_blank" rel="noopener noreferrer"><PlatformIcon os="GitHub" class="size-4" /><span class="sr-only">GitHub {t.opensInNewTab}</span></a>
      <a class="inline-flex items-center gap-2 rounded-lg px-2.5 py-2 text-fg/75 transition-colors hover:bg-fg/[0.06] hover:text-fg xl:px-3.5" href={REDDIT_URL} target="_blank" rel="noopener noreferrer"><PlatformIcon os="Reddit" class="size-4" /><span class="sr-only">Reddit {t.opensInNewTab}</span></a>
      <LanguageSwitcher />
      <a class="btn btn-primary ml-2 rounded-lg! px-4! py-2! text-sm" href={download.href} aria-current={download.current ? 'page' : undefined}>{download.label}</a>
    </nav>
    <button
      type="button"
      data-menu-button
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.nav.openMenu}
      data-label-open={t.nav.openMenu}
      data-label-close={t.nav.closeMenu}
      class="grid size-10 place-items-center rounded-lg text-fg/80 transition-colors hover:bg-fg/[0.06] hover:text-fg lg:hidden"
    >
      <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path data-icon-open d="M4 7h16M4 12h16M4 17h16" />
        <path data-icon-close class="hidden" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label={t.nav.mobile} hidden class="absolute inset-x-0 top-full px-4 pt-2 lg:hidden">
    <div class="glass mx-auto flex max-h-[calc(100dvh-5rem)] max-w-xl flex-col gap-1 overflow-y-auto bg-bg! p-2 text-base font-medium shadow-2xl">
      {links.map((l) => (
        <a class="rounded-lg px-3.5 py-3 text-fg/90 transition-colors hover:bg-fg/[0.06] hover:text-fg aria-[current=page]:bg-fg/[0.08]" href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="inline-flex items-center gap-2 rounded-lg px-3.5 py-3 text-fg/90 transition-colors hover:bg-fg/[0.06] hover:text-fg" href={REPO_URL} target="_blank" rel="noopener noreferrer"><PlatformIcon os="GitHub" class="size-5" />GitHub<span class="sr-only"> {t.opensInNewTab}</span></a>
      <a class="inline-flex items-center gap-2 rounded-lg px-3.5 py-3 text-fg/90 transition-colors hover:bg-fg/[0.06] hover:text-fg" href={REDDIT_URL} target="_blank" rel="noopener noreferrer"><PlatformIcon os="Reddit" class="size-5" />Reddit<span class="sr-only"> {t.opensInNewTab}</span></a>
      <div class="my-1 border-t border-[var(--hair)]"></div>
      <LanguageSwitcher variant="list" />
      <a class="btn btn-primary mx-1 mb-1 mt-1" href={download.href}>{download.label}</a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const button = header?.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = header?.querySelector<HTMLElement>('#mobile-menu');
  if (header && button && menu) {
    const iconOpen = button.querySelector('[data-icon-open]');
    const iconClose = button.querySelector('[data-icon-close]');
    const set = (open: boolean) => {
      menu.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? '');
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };
    button.addEventListener('click', () => set(button.getAttribute('aria-expanded') !== 'true'));
    // Close on link tap (same-page anchors don't reload), Escape, outside tap, or growing to desktop width.
    menu.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); button.focus(); } });
    document.addEventListener('click', (e) => { if (!menu.hidden && !header.contains(e.target as Node)) set(false); });
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }
</script>
