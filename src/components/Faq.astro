---
import { faq } from '../data/faq';
---

<section aria-label="Frequently asked questions">
  <div>
    <div class="divide-y divide-line rounded-2xl border border-line bg-surface">
      {
        faq.map((item) => (
          <details class="group p-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
              {item.q}
              <svg viewBox="0 0 24 24" class="size-5 shrink-0 text-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <p class="mt-3 text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
