---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { faq, faqGroups } from '../data/faq';
import { art } from '../data/illustrations';
import { REPO_URL } from '../data/platforms';

const description =
  'Answers about DegenView, the free, open source TradingView alternative: accounts, Pine Script, stock data, supported platforms and first-launch warnings.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const slug = (q: string) => q.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const groups = faqGroups.map((g) => ({ ...g, items: faq.filter((f) => f.group === g.id) }));
---

<Base
  title="DegenView FAQ – Free, Open Source TradingView Alternative"
  description={description}
  path="/faq/"
  jsonLd={jsonLd}
  breadcrumbs={[['Home', '/'], ['FAQ', '/faq/']]}
>
  <Header slot="header" />

  <!-- Hero with search -->
  <section class="relative overflow-hidden border-b border-line/50 pb-14 pt-16 sm:pt-24">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute left-1/2 top-[-12rem] h-[30rem] w-[54rem] -translate-x-1/2 rounded-full blur-3xl" style="background: radial-gradient(closest-side, var(--glow-a), transparent)"></div>
      <div class="absolute right-[-10rem] top-24 h-[24rem] w-[34rem] rounded-full blur-3xl" style="background: radial-gradient(closest-side, var(--glow-b), transparent)"></div>
    </div>
    <div class="container-x max-w-3xl text-center">
      <p class="text-sm font-semibold text-accent-text">faq</p>
      <h1 class="display mt-4 text-5xl sm:text-7xl">Questions, <span class="gradient-text">answered</span></h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-muted">Everything people ask before they download. If it isn’t here, ask on GitHub.</p>

      <form role="search" class="mx-auto mt-9 max-w-xl" data-faq-search hidden onsubmit="return false">
        <label for="faq-q" class="sr-only">Search the questions</label>
        <div class="relative">
          <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-4 top-1/2 z-10 size-5 -translate-y-1/2 text-muted" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.500-3.500" /></svg>
          <input id="faq-q" type="search" autocomplete="off" placeholder={`Search ${faq.length} questions`} class="w-full rounded-full border border-line bg-surface/80 py-3.5 pl-12 pr-5 text-base outline-none backdrop-blur transition-colors placeholder:text-muted focus:border-accent-text" />
        </div>
        <p class="mt-3 min-h-5 text-sm text-muted" aria-live="polite" data-faq-count></p>
      </form>
    </div>
  </section>

  <div class="container-x grid grid-cols-[minmax(0,1fr)] gap-12 py-16 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
    <!-- Topics: sticky list on desktop, scrolling chips on phones -->
    <nav aria-label="Topics" class="min-w-0 lg:sticky lg:top-28 lg:self-start">
      <p class="mb-3 hidden text-xs font-semibold uppercase tracking-wider text-muted lg:block">Topics</p>
      <ul class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 [scrollbar-width:none] lg:mx-0 lg:flex-col lg:gap-1 lg:overflow-visible lg:px-0 [&::-webkit-scrollbar]:hidden">
        {
          groups.map((g) => (
            <li class="shrink-0">
              <a
                href={`#${g.id}`}
                data-faq-nav={g.id}
                class="flex items-center justify-between gap-4 whitespace-nowrap rounded-full border border-line px-4 py-2 text-sm font-medium text-muted transition-colors hover:text-fg data-[active]:border-transparent data-[active]:bg-[var(--inverse)] data-[active]:text-[var(--inverse-ink)] lg:rounded-xl lg:border-transparent lg:px-3 lg:data-[active]:bg-chrome lg:data-[active]:text-fg"
              >
                {g.title}
                <span class="hidden font-mono text-xs opacity-60 lg:inline">{g.items.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="min-w-0 space-y-20">
      {
        groups.map((g) => (
          <section id={g.id} aria-labelledby={`${g.id}-h`} data-faq-group class="scroll-mt-28">
            <div class:list={['grid gap-6', g.art && 'md:grid-cols-[1fr_16rem] md:items-center']}>
              <div>
                <h2 id={`${g.id}-h`} class="display text-3xl sm:text-5xl">{g.title}</h2>
                <p class="mt-3 text-lg text-muted">{g.intro}</p>
              </div>
              {g.art && (
                <div class="relative aspect-[16/10] w-full overflow-hidden rounded-2xl border border-line bg-bg">
                  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,var(--glow-a),transparent_70%)]"></div>
                  <svg viewBox="0 0 320 200" class="absolute inset-0 size-full" role="img" aria-label={`${g.title} illustration`} set:html={art[g.art]} />
                </div>
              )}
            </div>

            <div class="mt-8 divide-y divide-line rounded-[14px] border border-line bg-surface">
              {
                g.items.map((f) => (
                  <details id={slug(f.q)} data-faq-item data-text={`${f.q} ${f.a}`.toLowerCase()} class="group scroll-mt-28">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-lg sm:p-6 font-semibold [&::-webkit-details-marker]:hidden">
                      {f.q}
                      <svg viewBox="0 0 24 24" class="size-5 shrink-0 text-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </summary>
                    <div class:list={['-mt-1 px-5 pb-5 sm:px-6 sm:pb-6', f.art && 'grid gap-6 md:grid-cols-[1fr_15rem] md:items-center']}>
                      <div>
                        <p class="text-base text-muted sm:text-lg">{f.a}</p>
                        {f.links && (
                          <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
                            {f.links.map(([label, href]) => (
                              <a class="inline-flex items-center gap-1 py-2 text-accent-text hover:underline" href={href}>
                                {label}
                                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                              </a>
                            ))}
                          </p>
                        )}
                      </div>
                      {f.art && (
                        <div class="relative aspect-[16/10] overflow-hidden rounded-xl border border-line bg-bg">
                          <svg viewBox="0 0 320 200" class="absolute inset-0 size-full" role="img" aria-label={`Illustration: ${f.q}`} set:html={art[f.art]} />
                        </div>
                      )}
                    </div>
                  </details>
                ))
              }
            </div>
          </section>
        ))
      }

      <p class="hidden rounded-[14px] border border-dashed border-line p-10 text-center text-muted" data-faq-empty>
        No question matches that. <a class="font-medium text-accent-text underline underline-offset-4" href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer">Ask on GitHub<span class="sr-only"> (opens in a new tab)</span></a> and we’ll add it.
      </p>
    </div>
  </div>

  <!-- Still stuck -->
  <section class="relative overflow-hidden border-t border-line/50 py-16 sm:py-24">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute left-1/2 top-1/2 h-[24rem] w-[48rem] -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl" style="background: radial-gradient(closest-side, var(--glow-a), transparent)"></div>
    </div>
    <div class="container-x max-w-3xl text-center">
      <h2 class="display text-4xl sm:text-6xl">Still have <span class="gradient-text">a question?</span></h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-muted">Open an issue and we’ll answer it. Or just download DegenView and see for yourself.</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="/download/" class="btn btn-gradient px-7 py-3.5">Download for free</a>
        <a href={`${REPO_URL}/issues`} target="_blank" rel="noopener noreferrer" class="btn btn-ghost px-7 py-3.5">Ask on GitHub<span class="sr-only"> (opens in a new tab)</span></a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-faq-search]');
    const input = document.getElementById('faq-q') as HTMLInputElement | null;
    const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-faq-group]')];
    const empty = document.querySelector<HTMLElement>('[data-faq-empty]');
    const count = document.querySelector<HTMLElement>('[data-faq-count]');

    // Search: shown only with JavaScript. Matches open, the rest hide, empty topics hide with them.
    if (form && input) {
      form.hidden = false;
      const run = () => {
        const q = input.value.trim().toLowerCase();
        const terms = q.split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const it of items) {
          const hit = terms.every((t) => it.dataset.text!.includes(t));
          it.hidden = !hit;
          if (hit) shown++;
          if (q) it.open = hit;
        }
        if (!q) items.forEach((it) => (it.open = false));
        for (const g of groups) g.hidden = ![...g.querySelectorAll('[data-faq-item]')].some((el) => !(el as HTMLElement).hidden);
        empty?.classList.toggle('hidden', shown > 0);
        if (count) count.textContent = q ? `${shown} ${shown === 1 ? 'question' : 'questions'} found` : '';
      };
      input.addEventListener('input', run);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && input.value) { input.value = ''; run(); }
      });
    }

    // Deep links: #question-slug opens that answer, and opening one puts its link in the address bar.
    const openFromHash = () => {
      const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      if (el instanceof HTMLDetailsElement) { el.open = true; el.scrollIntoView({ block: 'start' }); }
    };
    items.forEach((it) => it.addEventListener('toggle', () => { if (it.open && !input?.value) history.replaceState(null, '', `#${it.id}`); }));
    openFromHash();
    addEventListener('hashchange', openFromHash);

    // Topic list follows the scroll.
    const links = new Map(groups.map((g) => [g.id, document.querySelector<HTMLElement>(`[data-faq-nav="${g.id}"]`)!]));
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { links.forEach((l, id) => l.toggleAttribute('data-active', id === e.target.id)); }
      }),
      { rootMargin: '-25% 0px -65% 0px' },
    );
    groups.forEach((g) => io.observe(g));
  </script>
</Base>
