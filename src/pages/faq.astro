---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import { faq } from '../data/faq';

const description =
  'Answers about DegenView, the free, open source TradingView alternative: accounts, Pine Script, stock data, supported platforms and first-launch warnings.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title="DegenView FAQ – Free, Open Source TradingView Alternative"
  description={description}
  path="/faq/"
  jsonLd={jsonLd}
  breadcrumbs={[['Home', '/'], ['FAQ', '/faq/']]}
>
  <Header slot="header" />
  <div class="container-x max-w-3xl py-20">
    <h1 class="display text-center text-5xl sm:text-7xl">Questions, <span class="gradient-text">answered</span></h1>
    <div class="mt-12"><Faq /></div>
  </div>
  <Footer slot="footer" />
</Base>
