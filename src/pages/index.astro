---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sources from '../components/Sources.astro';
import Feature from '../components/Feature.astro';
import Privacy from '../components/Privacy.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Footer from '../components/Footer.astro';
import { features } from '../data/features';
import { getRelease } from '../data/release';
import { LATEST_URL, REPO_URL } from '../data/platforms';

const release = await getRelease();
const SITE = 'https://degenview.app';
const description =
  'DegenView is a free, open-source desktop dashboard for crypto, stocks and prediction markets: multi-chart layouts, local Pine Script v6, price alerts, bar replay and portfolio tracking. macOS, Windows, Linux.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'DegenView',
    url: SITE,
    description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'macOS, Windows, Linux',
    isAccessibleForFree: true,
    license: 'https://www.gnu.org/licenses/gpl-3.0.html',
    image: `${SITE}/og.png`,
    ...(release.tag ? { softwareVersion: release.tag.replace(/^v/, '') } : {}),
    downloadUrl: LATEST_URL,
    codeRepository: REPO_URL,
    author: { '@type': 'Person', name: 'Nico Oelgart' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: features.map((f) => f.title),
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'DegenView', url: SITE },
];
---

<Base title="DegenView – Free Multi-Chart Crypto & Stock Dashboard" description={description} jsonLd={jsonLd}>
  <Header slot="header" />
  <Hero tag={release.tag} />
  <Sources />
  <section id="features" aria-labelledby="features-h" class="pb-10">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="font-mono text-sm font-semibold text-accent-text">features</p>
        <h2 id="features-h" class="mt-3 text-balance text-3xl font-bold tracking-tight sm:text-5xl">Everything a market dashboard should have</h2>
      </div>
      <div class="divide-y divide-line/60">
        {features.map((f, i) => <Feature feature={f} flip={i % 2 === 1} />)}
      </div>
    </div>
  </section>
  <Privacy />
  <section aria-labelledby="dl-h" class="py-24">
    <div class="container-x text-center">
      <h2 id="dl-h" class="text-balance text-3xl font-bold tracking-tight sm:text-5xl">Get DegenView. It’s free.</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted">Latest release <span class="font-mono" data-dl-version>{release.tag ?? ''}</span>. No account, no trial, no catch.</p>
      <div class="mt-8 flex justify-center"><DownloadButton showNote /></div>
      <p class="mt-8 text-sm text-muted">
        <a class="font-medium text-accent-text underline underline-offset-4" href="/download/">All downloads</a> ·
        <a class="font-medium text-accent-text underline underline-offset-4" href="/why-free/">Why is it free?</a> ·
        <a class="font-medium text-accent-text underline underline-offset-4" href="/faq/">FAQ</a>
      </p>
    </div>
  </section>
  <Footer slot="footer" />
  <script>
    import { initParallax } from '../scripts/parallax';
    initParallax();
  </script>
</Base>
