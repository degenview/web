---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sources from '../components/Sources.astro';
import Feature from '../components/Feature.astro';
import ChartTypes from '../components/ChartTypes.astro';
import MoreFeatures from '../components/MoreFeatures.astro';
import Privacy from '../components/Privacy.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Footer from '../components/Footer.astro';
import SectionNav from '../components/SectionNav.astro';
import { features, extras } from '../data/features';
import { getImage } from 'astro:assets';
import heroImage from '../assets/screens/hero-dark.webp';
import AlternativeTeaser from '../components/AlternativeTeaser.astro';
import { getRelease } from '../data/release';
import { LATEST_URL, REPO_URL } from '../data/platforms';

const release = await getRelease();
const SITE = 'https://degenview.app';
const description =
  'A free, open source TradingView alternative for desktop: multi-chart layouts, local Pine Script v6, alerts, replay and portfolios. macOS, Windows, Linux.';
const heroShot = await getImage({ src: heroImage, width: 1280 });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'DegenView',
    alternateName: ['DegenView – open source TradingView alternative', 'DegenView Charts'],
    url: SITE,
    description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'macOS, Windows, Linux',
    isAccessibleForFree: true,
    license: 'https://www.gnu.org/licenses/gpl-3.0.html',
    image: `${SITE}/og.png`,
    screenshot: `${SITE}${heroShot.src}`,
    sameAs: [REPO_URL],
    softwareHelp: `${SITE}/faq/`,
    ...(release.tag ? { softwareVersion: release.tag.replace(/^v/, '') } : {}),
    downloadUrl: LATEST_URL,
    codeRepository: REPO_URL,
    author: { '@type': 'Person', name: 'Nico Oelgart' },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [...features.map((f) => f.title), ...extras.map((e) => e.title.replace(/\*$/, ''))],
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'DegenView', url: SITE },
];
---

<Base title="DegenView – Free, Open Source TradingView Alternative" description={description} jsonLd={jsonLd}>
  <Header slot="header" />
  <SectionNav />
  <Hero />
  <Sources />
  <section id="features" aria-labelledby="features-h" class="pb-10">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold text-accent-text">features</p>
        <h2 id="features-h" class="display mt-3 text-4xl sm:text-6xl">Everything a market dashboard <span class="gradient-text">should have</span></h2>
      </div>
      <div class="divide-y divide-line/50">
        {features.map((f, i) => <Feature feature={f} flip={i % 2 === 1} />)}
      </div>
    </div>
  </section>
  <ChartTypes />
  <MoreFeatures />
  <AlternativeTeaser />
  <Privacy />
  <section id="download" aria-labelledby="dl-h" class="py-32">
    <div class="container-x text-center">
      <h2 id="dl-h" class="display text-4xl sm:text-7xl">Get DegenView. <span class="gradient-text block">It’s free.</span></h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted">Latest release <span class="font-mono" data-dl-version>{release.tag ?? ''}</span>. No account, no trial, no catch.</p>
      <div class="mt-8 flex justify-center"><DownloadButton showNote /></div>
      <p class="mt-8 text-sm text-muted">
        <a class="font-medium text-accent-text underline underline-offset-4" href="/download/">All downloads</a> ·{' '}
        <a class="font-medium text-accent-text underline underline-offset-4" href="/faq/">FAQ</a>
      </p>
    </div>
  </section>
  <Footer slot="footer" />
</Base>
