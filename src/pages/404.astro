---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { fmt, localeMeta, locales, useT } from '../i18n';
// GitHub Pages serves ONE 404.html for every path, so it is built in English and a small script
// swaps in the text of the language in the URL (/es/nope → Spanish). Texts for all locales are inlined.
const render = (l: (typeof locales)[number]) => {
  const n = useT(l).common.notFound;
  return {
    htmlLang: localeMeta[l].htmlLang,
    title: n.title,
    heading: fmt(n.heading, { accent: `<span class="gradient-text">${n.headingAccent}</span>` }),
    body: n.body,
    button: n.button,
  };
};
const all = Object.fromEntries(locales.map((l) => [l, render(l)]));
const t = all.en;
const json = JSON.stringify(all).replace(/</g, '\\u003c');
---

<Base title={t.title} description={useT('en').common.notFound.description} path="/404" noindex>
  <Header slot="header" />
  <section class="relative py-16 sm:py-24">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container-x">
      <div class="glass stage relative mx-auto max-w-3xl">
        <span class="glow-line absolute inset-x-10 top-0" aria-hidden="true"></span>
        <div class="p-6 text-center sm:p-8 lg:p-10">
          <p class="big-num">404</p>
          <h1 data-nf-heading class="display mt-6 text-5xl sm:text-6xl" set:html={t.heading}></h1>
          <p data-nf-body class="mx-auto mt-5 max-w-xl text-lg text-muted">{t.body}</p>
          <a data-nf-button href="/" class="btn btn-gradient mt-8 px-7 py-3.5">{t.button}</a>
        </div>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
  <script is:inline type="application/json" id="nf-i18n" set:html={json}></script>
  <script is:inline>
    (function () {
      var data = JSON.parse(document.getElementById('nf-i18n').textContent);
      var seg = location.pathname.split('/')[1];
      var lang = seg !== 'en' && data[seg] ? seg : 'en';
      if (lang === 'en') return;
      var d = data[lang];
      document.documentElement.lang = d.htmlLang;
      document.title = d.title;
      document.querySelector('[data-nf-heading]').innerHTML = d.heading;
      document.querySelector('[data-nf-body]').textContent = d.body;
      var b = document.querySelector('[data-nf-button]');
      b.textContent = d.button;
      b.setAttribute('href', '/' + lang + '/');
      // Keep header/footer navigation inside the language the visitor was reading.
      document.querySelectorAll('header a[href^="/"], footer a[href^="/"]').forEach(function (a) {
        var h = a.getAttribute('href');
        if (h.indexOf('//') === 0 || a.hasAttribute('hreflang') || h.indexOf('/' + lang + '/') === 0 || h === '/' + lang || /^\/(_astro|favicon|icon-|og\.png)/.test(h)) return;
        a.setAttribute('href', '/' + lang + h);
      });
    })();
  </script>
</Base>
