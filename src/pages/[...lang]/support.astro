---
import { getStaticPaths as paths } from '../../i18n/paths';
export const getStaticPaths = paths;
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import { COFFEE_URL, REDDIT_URL, REPO_URL } from '../../data/platforms';
import { DOCS_REPO_URL, ISSUES_URL, WALLETS, WEB_REPO_URL, getStars } from '../../data/support';
import { getSupporters } from '../../data/supporters';
import PlatformIcon from '../../components/PlatformIcon.astro';
import { SITE, fmt, getLang, localeMeta, localePath, useT } from '../../i18n';

const lang = getLang(Astro.url);
const dict = useT(lang);
const t = dict.support;
const sr = ' ' + dict.common.opensInNewTab;
const [stars, supporters] = await Promise.all([getStars(), getSupporters()]);
const locale = localeMeta[lang].intl;
const graphemes = new Intl.Segmenter(locale, { granularity: 'grapheme' });
const starsLabel = stars ? fmt(t.free.star.count, { count: new Intl.NumberFormat(localeMeta[lang].intl, { notation: 'compact', maximumFractionDigits: 1 }).format(stars) }) : undefined;
const hasWallets = WALLETS.length > 0;
// X post composer, pre-filled with a line about DegenView and this language's home page.
const shareOnX = `https://x.com/intent/post?text=${encodeURIComponent(t.free.share.xText)}&url=${encodeURIComponent(new URL(localePath(lang, '/'), SITE).href)}`;

// Lucide-style 24px outline icons.
const icons = {
  coffee: 'M4 10h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5zM17 11h1.5a2.5 2.5 0 0 1 0 5H17M8 3v3M12 3v3',
  wallet: 'M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4',
  star: 'M12 2.5l2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.3l-5.8 3.1 1.1-6.45-4.7-4.6 6.5-.95z',
  share: 'M18 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6M6 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6M18 22a3 3 0 1 0 0-6 3 3 0 0 0 0 6M8.6 13.5l6.8 4M15.4 6.5l-6.8 4',
  chat: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  code: 'm16 18 6-6-6-6M8 6l-6 6 6 6',
} as const;
type Icon = keyof typeof icons;

const arrow = 'M5 12h14m-6-6 6 6-6 6';
const linkCls = 'inline-flex items-center gap-1.5 py-2 text-accent-text hover:underline';
const linkRow = 'flex flex-wrap gap-x-6 gap-y-1 font-mono text-xs font-medium uppercase tracking-[0.12em]';

const free: { icon: Icon; title: string; body: string; links: [string, string, ('X' | 'Reddit')?][]; tag?: string }[] = [
  { icon: 'star', title: t.free.star.title, body: t.free.star.body, links: [[t.free.star.button, REPO_URL]], tag: starsLabel },
  { icon: 'share', title: t.free.share.title, body: t.free.share.body, links: [[t.free.share.x, shareOnX, 'X'], ['Reddit', REDDIT_URL, 'Reddit']] },
  { icon: 'chat', title: t.free.feedback.title, body: t.free.feedback.body, links: [[t.free.feedback.button, ISSUES_URL]] },
  {
    icon: 'code',
    title: t.free.contribute.title,
    body: t.free.contribute.body,
    links: [[t.free.contribute.code, REPO_URL], [t.free.contribute.translations, WEB_REPO_URL], [t.free.contribute.docs, DOCS_REPO_URL]],
  },
];
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path="/support/"
  breadcrumbs={[[t.breadcrumbs.home, '/'], [t.breadcrumbs.support, '/support/']]}
>
  <Header slot="header" />

  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lead={t.hero.lead} align="left">
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={COFFEE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gradient px-7 py-3.5">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.coffee} /></svg>
        {dict.common.coffee}<span class="sr-only">{sr}</span>
      </a>
      <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost px-7 py-3.5">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.star} /></svg>
        {t.hero.star}<span class="sr-only">{sr}</span>
      </a>
    </div>
    <p class="mt-5 max-w-xl text-sm text-muted">{t.hero.note}</p>
  </PageHero>

  <!-- Chip in -->
  <section id="chip-in" aria-labelledby="chip-in-h" class="py-16 sm:py-24">
    <div class="container-x">
      <SectionHead id="chip-in-h" align="left" eyebrow={t.chipIn.eyebrow} title={t.chipIn.title} lead={t.chipIn.lead} />

      <ul class:list={['mt-10 grid gap-4 sm:mt-12 sm:gap-6', hasWallets && 'lg:grid-cols-2']}>
        <li data-reveal class="flex min-w-0">
          <div class="card stage relative w-full overflow-hidden">
            <span class="glow-line absolute inset-x-10 top-0" aria-hidden="true"></span>
            <div class:list={['grid h-full', !hasWallets && 'lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]']}>
              <div class="flex flex-col p-6 sm:p-8 lg:p-10">
                <div class="flex items-center justify-between gap-3">
                  <span class="card-index">01</span>
                  <span class="tag">{t.chipIn.coffee.tag}</span>
                </div>
                <svg viewBox="0 0 24 24" class="mt-6 size-9 text-[#ffdd00]" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.coffee} /></svg>
                <h3 class="display mt-4 text-4xl sm:text-5xl">{t.chipIn.coffee.title}</h3>
                <p class="mt-3 max-w-lg text-muted sm:text-lg">{t.chipIn.coffee.body}</p>
                <div class="mt-auto pt-8">
                  <a href={COFFEE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gradient px-7 py-3.5">{dict.common.coffee}<span class="sr-only">{sr}</span></a>
                </div>
              </div>
              {!hasWallets && (
                <div class="relative min-h-52 border-t border-[var(--hair)] lg:border-l lg:border-t-0" aria-hidden="true">
                  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_70%,rgb(255_221_0/0.16),transparent_65%)]"></div>
                  <svg viewBox="0 0 320 200" class="absolute inset-0 size-full text-[#ffdd00]" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <g class="candle"><path d="M135 28v44" /><rect x="130" y="40" width="10" height="22" rx="1.5" fill="currentColor" fill-opacity=".35" /></g>
                    <g class="candle" style="animation-delay:-.8s"><path d="M160 22v50" /><rect x="155" y="32" width="10" height="28" rx="1.5" fill="currentColor" fill-opacity=".35" /></g>
                    <g class="candle" style="animation-delay:-1.6s"><path d="M185 30v42" /><rect x="180" y="42" width="10" height="18" rx="1.5" fill="currentColor" fill-opacity=".35" /></g>
                    <path d="M108 82h104v28a52 52 0 0 1-52 52 52 52 0 0 1-52-52z" fill="currentColor" fill-opacity=".1" />
                    <path d="M212 94h12a17 17 0 0 1 0 34h-14" />
                    <path d="M84 170c24 10 128 10 152 0" />
                    <path d="M124 100v10M196 100v10" opacity=".35" />
                  </svg>
                </div>
              )}
            </div>
          </div>
        </li>
        {hasWallets && (
          <li data-reveal style="--i:1" class="flex min-w-0">
            <div class="card relative flex w-full flex-col p-6 sm:p-8">
              <div class="flex items-center justify-between gap-3">
                <span class="card-index">02</span>
                <span class="tag">{t.chipIn.crypto.tag}</span>
              </div>
              <svg viewBox="0 0 24 24" class="mt-6 size-9 text-accent-text" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.wallet} /></svg>
              <h3 class="display mt-4 text-4xl sm:text-5xl">{t.chipIn.crypto.title}</h3>
              <p class="mt-3 max-w-lg text-muted sm:text-lg">{t.chipIn.crypto.body}</p>
              <div class="mt-auto pt-8">
                <a href="#crypto" class="btn btn-ghost px-7 py-3.5">{t.chipIn.crypto.button}</a>
              </div>
            </div>
          </li>
        )}
      </ul>
    </div>
  </section>

  <!-- Crypto addresses: shown only once WALLETS (src/data/support.ts) has an entry -->
  {hasWallets && (
    <section id="crypto" aria-labelledby="crypto-h" class="scroll-mt-20 pb-16 sm:pb-24">
      <div class="container-x">
        <div class="glass p-6 sm:p-8 lg:p-10" data-reveal>
          <p class="kicker">{t.crypto.eyebrow}</p>
          <h2 id="crypto-h" class="display mt-4 text-5xl sm:text-6xl" set:html={t.crypto.title} />
          <p class="mt-4 max-w-2xl text-lg text-muted">{t.crypto.lead}</p>

          <ul aria-label={t.crypto.list} class="mt-8 space-y-3 sm:space-y-4">
            {
              WALLETS.map((w) => (
                <li class="card flex flex-col gap-4 p-4 sm:p-5 lg:flex-row lg:items-center lg:gap-6">
                  <div class="flex items-center gap-4 lg:w-60 lg:shrink-0">
                    <span aria-hidden="true" class="grid size-12 shrink-0 place-items-center rounded-full border border-[var(--hair)] bg-[var(--tile)] font-mono text-[0.7rem] font-semibold tracking-wide">{w.ticker}</span>
                    <div class="min-w-0">
                      <h3 class="font-semibold">{w.name}</h3>
                      <p class="mono-label mt-1">{w.network}</p>
                    </div>
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-col gap-2 sm:flex-row sm:items-stretch">
                      <code
                        id={`addr-${w.id}`}
                        aria-label={fmt(t.crypto.addressLabel, { name: w.name })}
                        class="block min-w-0 flex-1 break-all rounded-lg border border-[var(--hair)] bg-bg px-3.5 py-3 font-mono text-[13px] leading-relaxed [-webkit-user-select:all] select-all"
                      >{w.address}</code>
                      <button
                        type="button"
                        data-copy={w.address}
                        class="shrink-0 rounded-lg border border-[var(--hair)] px-5 py-3 font-mono text-[0.68rem] font-medium uppercase tracking-[0.12em] text-fg transition-colors hover:border-[var(--hair-hi)] hover:bg-[var(--tile)] sm:min-w-28"
                        aria-label={fmt(t.crypto.copyAria, { name: w.name })}
                      >{t.crypto.copy}</button>
                    </div>
                    <p class="mt-2 text-sm text-muted">{fmt(t.crypto.network, { ticker: w.ticker, network: w.network })}</p>
                  </div>
                </li>
              ))
            }
          </ul>

          <p class="card mt-6 flex items-start gap-3 px-4 py-3 text-sm text-muted" role="note">
            <svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0 text-accent-text" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z" /><path d="m9 12 2 2 4-4" /></svg>
            <span>{t.crypto.safety}</span>
          </p>
        </div>
      </div>
    </section>
  )}

  {supporters.length > 0 && (
    <section id="supporters" aria-labelledby="supporters-h" class="scroll-mt-20 pb-16 sm:pb-24">
      <div class="container-x">
        <div class="glass stage relative p-6 sm:p-8 lg:p-10">
          <span class="glow-line absolute inset-x-10 top-0" aria-hidden="true"></span>
          <SectionHead id="supporters-h" align="left" title={t.supporters.title} lead={t.supporters.lead} />

          <ul class="mt-8 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
            {supporters.map(({ name, photo, amount, currency }) => {
              const initial = name ? graphemes.segment(name).containing(0)?.segment.toLocaleUpperCase(locale) : undefined;
              const formattedAmount = new Intl.NumberFormat(locale, { style: 'currency', currency }).format(amount);

              return (
                <li class="card flex min-w-0 items-center gap-x-3 px-3 py-3 sm:gap-x-4 sm:px-4">
                  <span class="supporter-avatar relative grid size-11 shrink-0 place-items-center overflow-hidden rounded-full border font-mono text-sm font-semibold text-accent-text" aria-hidden="true">
                    {initial ?? (
                      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={icons.coffee} /></svg>
                    )}
                    {photo && <img src={photo} alt="" width="44" height="44" class="absolute inset-0 size-full bg-bg object-cover" loading="lazy" decoding="async" referrerpolicy="no-referrer" data-supporter-photo />}
                  </span>
                  <div class="flex min-w-0 flex-1 flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <bdi class="min-w-0 font-semibold wrap-anywhere">{name ?? t.supporters.anonymous}</bdi>
                    <bdi class="shrink-0 whitespace-nowrap font-mono text-sm font-semibold text-accent-text tabular-nums">{formattedAmount}</bdi>
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- Free ways -->
  <section id="free" aria-labelledby="free-h" class="pb-16 sm:pb-24">
    <div class="container-x">
      <SectionHead id="free-h" align="left" eyebrow={t.free.eyebrow} title={t.free.title} lead={t.free.lead} />

      <ul class="mt-10 grid gap-4 sm:mt-12 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
        {
          free.map((c, i) => (
            <li data-reveal style={`--i:${i}`} class="flex min-w-0">
              <div class="card flex w-full flex-col p-5 sm:p-6">
                <div class="flex items-center justify-between gap-3">
                  <span class="card-index">{String(i + (hasWallets ? 3 : 2)).padStart(2, '0')}</span>
                  <span class="tag !text-up">{c.tag ?? t.free.badge}</span>
                </div>
                <svg viewBox="0 0 24 24" class="mt-5 size-7 text-accent-text" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[c.icon]} /></svg>
                <h3 class="display mt-3 text-3xl">{c.title}</h3>
                <p class="mt-3 text-muted">{c.body}</p>
                <p class:list={[linkRow, 'mt-auto pt-5']}>
                  {c.links.map(([label, href, brand]) => (
                    <a class={linkCls} href={href} target="_blank" rel="noopener noreferrer">
                      {brand && <PlatformIcon os={brand} class="size-3.5" />}
                      {label}
                      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
                      <span class="sr-only">{sr}</span>
                    </a>
                  ))}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Good to know -->
  <section id="good" aria-labelledby="good-h" class="pb-16 sm:pb-24">
    <div class="container-x">
      <SectionHead id="good-h" align="left" eyebrow={t.good.eyebrow} title={t.good.title} />
      <ul class="rows mt-10 sm:mt-12" data-reveal>
        {
          t.good.items.map((item, i) => (
            <li class="row">
              <p class="row-claim"><span class="card-index !text-base">{String(i + 1).padStart(2, '0')}</span><span>{item.claim}</span></p>
              <p class="row-text">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Thanks -->
  <section class="pb-16 sm:pb-24">
    <div class="container-x">
      <div class="glass stage relative mx-auto max-w-4xl" data-reveal="scale">
        <span class="glow-line absolute inset-x-10 top-0" aria-hidden="true"></span>
        <div class="p-6 text-center sm:p-8 lg:p-10">
          <svg viewBox="0 0 24 24" class="mx-auto size-8 text-accent-text" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" /></svg>
          <h2 class="display mt-4 text-5xl sm:text-6xl" set:html={t.cta.title} />
          <p class="mx-auto mt-5 max-w-xl text-lg text-muted">{t.cta.lead}</p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a href={localePath(lang, '/download/')} class="btn btn-gradient px-7 py-3.5">{dict.common.nav.download}</a>
            <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost px-7 py-3.5">{t.hero.star}<span class="sr-only">{sr}</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <div hidden data-copy-labels data-copied={t.crypto.copied} data-copy-failed={t.crypto.copyFailed}></div>
  <div class="sr-only" role="status" aria-live="polite" data-copy-status></div>

  <script>
    import { initCopy } from '../../scripts/copy';
    initCopy();

    for (const photo of document.querySelectorAll<HTMLImageElement>('[data-supporter-photo]')) {
      const showFallback = () => photo.remove();
      if (photo.complete && photo.naturalWidth === 0) showFallback();
      else photo.addEventListener('error', showFallback, { once: true });
    }
  </script>

  <style>
    .supporter-avatar {
      background: linear-gradient(135deg, color-mix(in oklab, var(--accent) 14%, var(--surface)), color-mix(in oklab, var(--purple) 12%, var(--surface)));
      border-color: color-mix(in oklab, var(--accent) 25%, var(--hair));
    }

    /* Candles bobbing above the cup: each one drifts up and down, out of step with its neighbours. */
    @keyframes candle { 0%, 100% { transform: translateY(6px); } 50% { transform: translateY(-6px); } }
    .candle { animation: candle 2.4s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) { .candle { animation: none; } }
  </style>
</Base>
