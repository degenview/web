---
import { getStaticPaths as paths } from '../../i18n/paths';
export const getStaticPaths = paths;
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PlatformIcon from '../../components/PlatformIcon.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PreReleaseNote from '../../components/PreReleaseNote.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import { getRelease } from '../../data/release';
import { OS_NAMES, PLATFORMS, REPO_URL, RELEASES_URL, assetUrl, formatName, type Platform } from '../../data/platforms';
import { SITE, fmt, getLang, localeMeta, localePath, useT } from '../../i18n';

const lang = getLang(Astro.url);
const { intl, htmlLang } = localeMeta[lang];
const t = useT(lang).download;
const sr = ' ' + useT(lang).common.opensInNewTab;

const release = await getRelease();
const tag = release.tag;
const T = tag ?? '<version>';
// `degenview@rc` follows release candidates and finals; `degenview` is the newest final only, so it
// is named only once the newest release is one. Homebrew trusts a fully named cask as it installs.
const brewCask = !tag || tag.includes('-') ? 'degenview@rc' : 'degenview';
// The Flatpak repo has the same two tracks: `beta` follows release candidates and finals, `stable`
// follows finals only and exists once one is published.
const flatpakBranch = !tag || tag.includes('-') ? 'beta' : 'stable';
// Escaped because it ends up inside dictionary strings that are rendered as HTML.
const Th = T.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const dateFormat = new Intl.DateTimeFormat(intl, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const date = (iso?: string) => (iso ? dateFormat.format(new Date(iso)) : undefined);
const size = (bytes?: number) => {
  if (!bytes) return undefined;
  const digits = bytes >= 100 * 1024 * 1024 ? 0 : 1;
  return `${(bytes / 1024 / 1024).toLocaleString(intl, { minimumFractionDigits: digits, maximumFractionDigits: digits, useGrouping: false })} MB`;
};
const asset = (p: Platform, i: number) => tag ? release.assets[`DegenView-${tag}-${p.id}${p.formats[i].suffix}`] : undefined;
const fileName = (p: Platform, i: number) => `DegenView-${T}-${p.id}${p.formats[i].suffix}`;

const statusKey = !tag ? null : /-rc\./.test(tag) ? 'rc' : release.prerelease ? 'prerelease' : 'stable';
const status = statusKey && t.status[statusKey];
const published = date(release.published);

// Checksums by OS, for the verify section. Empty when GitHub didn't report them at build time.
const checksums = OS_NAMES.map((os) => ({
  os,
  rows: PLATFORMS.filter((p) => p.os === os).flatMap((p) =>
    p.formats.map((_f, i) => ({ name: fileName(p, i), sha: asset(p, i)?.sha256 })),
  ).filter((r) => r.sha),
})).filter((g) => g.rows.length);


const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    inLanguage: htmlLang,
    name: 'DegenView',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'macOS, Windows, Linux',
    softwareRequirements: t.meta.softwareRequirements,
    isAccessibleForFree: true,
    license: 'https://www.gnu.org/licenses/gpl-3.0.html',
    ...(tag ? { softwareVersion: tag.replace(/^v/, '') } : {}),
    ...(release.published ? { datePublished: release.published } : {}),
    downloadUrl: release.htmlUrl,
    installUrl: SITE + localePath(lang, '/download/'),
    releaseNotes: release.htmlUrl,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];

const arrow = 'M12 4v12m0 0 5-5m-5 5-5-5M5 20h14';
const archLabel = { arm64: 'ARM64', x64: 'x64' } as const;
const osArchs = (os: string) => [...new Set(PLATFORMS.filter((p) => p.os === os).map((p) => archLabel[p.arch]))].join(' · ');
const two = (n: number) => String(n).padStart(2, '0');
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path="/download/"
  jsonLd={jsonLd}
  breadcrumbs={[[t.breadcrumbs.home, '/'], [t.breadcrumbs.download, '/download/']]}
>
  <Header slot="header" />

  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lead={t.hero.lead} align="left">
    <div class="mt-8 flex flex-col items-start gap-3">
      <a href="#all" data-dl-primary class="btn btn-gradient gap-3 px-9 py-4 text-lg">
        {OS_NAMES.map((os) => <span data-os-icon={os} hidden><PlatformIcon os={os} class="size-6" /></span>)}
        <span data-dl-primary-label>{t.hero.choose}</span>
      </a>
      <p class="mono-label min-h-4" data-dl-primary-meta></p>
      <p class="text-sm text-muted" data-dl-note hidden></p>
      <a href="#all" class="inline-block py-1 font-mono text-xs font-medium uppercase tracking-[0.14em] text-accent-text underline-offset-4 hover:underline">{t.hero.other}</a>
    </div>

    <ul class="mt-6 flex flex-wrap items-center gap-2">
      {tag && (
        <li class="tag gap-2">
          <span class="!text-fg" data-dl-version>{tag}</span>
          {status && <span class:list={[statusKey === 'stable' ? 'text-up' : 'text-[#f5a524]']}>{status}</span>}
        </li>
      )}
      {published && <li class="tag" data-dl-static>{fmt(t.hero.released, { date: published })}</li>}
    </ul>
    <PreReleaseNote class="mt-6 mx-0!" />
  </PageHero>

  <!-- All downloads -->
  <section id="all" aria-labelledby="all-h" class="py-16 sm:py-24">
    <div class="container-x">
      <SectionHead id="all-h" align="left" eyebrow={t.all.eyebrow} title={t.all.title} lead={t.all.lead} />

      <ul class="mt-10 grid gap-4 sm:mt-12 sm:gap-6 lg:grid-cols-3">
        {
          OS_NAMES.map((os, n) => (
            <li data-reveal style={`--i:${n}`} class="flex min-w-0">
              <div data-dl-os-card={os} class="card os-card flex w-full min-w-0 flex-col p-5 sm:p-6">
                <div class="flex items-center justify-between gap-3">
                  <span class="card-index">{two(n + 1)}</span>
                  <span class="tag">{osArchs(os)}</span>
                </div>
                <div class="mt-5 flex items-center gap-3">
                  <PlatformIcon os={os} class="size-8 shrink-0" />
                  <h3 class="display text-3xl sm:text-4xl">{os}</h3>
                </div>
                <p class="mt-3 text-sm text-muted lg:min-h-10">{t.all.needs[os]}</p>
                <div class="mt-4 space-y-2">
                  {
                    PLATFORMS.filter((p) => p.os === os).map((p) => (
                      <div data-dl-arch data-platform={p.id} class="rounded-xl border border-transparent p-3 transition-colors data-[selected]:border-[var(--hair-hi)] data-[selected]:bg-[var(--tile)]">
                        <div class="flex items-center justify-between gap-3">
                          <p class="text-sm font-semibold">{t.all.archHints[p.id]}</p>
                          <span data-dl-recommended hidden class="tag shrink-0 !text-accent-text">{t.all.recommended}</span>
                        </div>
                        <ul class="mt-3 space-y-2">
                          {
                            p.formats.map((f, i) => (
                              <li>
                                <a
                                  href={assetUrl(tag, p, f)}
                                  data-dl-file
                                  data-platform={p.id}
                                  data-suffix={f.suffix}
                                  data-default={i === 0 ? '' : undefined}
                                  data-meta={[p.short, f.ext && `.${f.ext}`, size(asset(p, i)?.size)].filter(Boolean).join(' · ')}
                                  class="group flex items-center justify-between gap-4 rounded-lg border border-[var(--hair)] bg-[var(--tile)] px-4 py-3 transition-colors hover:border-[var(--hair-hi)]"
                                >
                                  <span class="min-w-0">
                                    <span class="block font-medium">{formatName(useT(lang).common, f)}</span>
                                    <span class="mono-label block normal-case tracking-normal">{f.ext ?`.${f.ext}` : ''}<span data-dl-static>{size(asset(p, i)?.size) ? `${f.ext ? ' · ' : ''}${size(asset(p, i)?.size)}` : ''}</span></span>
                                  </span>
                                  <svg viewBox="0 0 24 24" class="size-5 shrink-0 text-muted transition-transform group-hover:translate-y-0.5 group-hover:text-fg" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
                                </a>
                              </li>
                            ))
                          }
                        </ul>
                      </div>
                    ))
                  }
                </div>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-muted" data-reveal="fade" set:html={fmt(t.all.older, { url: RELEASES_URL })} />
    </div>
  </section>

  <!-- Install -->
  <section id="install" aria-labelledby="install-h" class="py-16 sm:py-24">
    <div class="container-x">
      <SectionHead id="install-h" align="left" eyebrow={t.install.eyebrow} title={t.install.title} />

      <div class="glass relative mt-10 divide-y divide-[var(--hair)] p-6 sm:mt-12 sm:p-8 lg:p-10" data-reveal="fade">
        <div data-dl-os-card="macOS" class="os-row min-w-0 pb-8 sm:pb-10">
          <h3 class="os-title display flex items-center gap-3 text-3xl sm:text-4xl"><PlatformIcon os="macOS" class="size-7 shrink-0" />macOS</h3>
          <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-12">
            <ol class="grid content-start gap-6">
              {t.install.macos.steps.map((step, i) => <li class="grid grid-cols-[4rem_minmax(0,1fr)] items-start gap-4" set:html={`<span class="big-num text-[3.5rem]!" aria-hidden="true">${two(i + 1)}</span><span class="min-w-0 pt-1 text-muted">${step}</span>`} />)}
            </ol>
            <div class="min-w-0">
              <p class="mono-label">{t.install.macos.brewTitle}</p>
              <div class="mt-3"><CodeBlock label="terminal" code={`brew install --cask degenview/degenview/${brewCask}`} /></div>
              <p class="mt-4 text-sm text-muted" set:html={t.install.macos.brewNote} />
            </div>
          </div>
        </div>

        <div data-dl-os-card="Windows" class="os-row min-w-0 py-8 sm:py-10">
          <h3 class="os-title display flex items-center gap-3 text-3xl sm:text-4xl"><PlatformIcon os="Windows" class="size-7 shrink-0" />Windows</h3>
          <ol class="mt-6 grid gap-6 lg:grid-cols-2 lg:gap-x-12">
            {t.install.windows.steps.map((step, i) => <li class="grid grid-cols-[4rem_minmax(0,1fr)] items-start gap-4" set:html={`<span class="big-num text-[3.5rem]!" aria-hidden="true">${two(i + 1)}</span><span class="min-w-0 pt-1 text-muted">${step}</span>`} />)}
          </ol>
        </div>

        <div data-dl-os-card="Linux" class="os-row min-w-0 pt-8 sm:pt-10">
          <h3 class="os-title display flex items-center gap-3 text-3xl sm:text-4xl"><PlatformIcon os="Linux" class="size-7 shrink-0" />Linux</h3>
          <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-12">
            <div class="min-w-0">
              <p class="mono-label">{t.install.linux.tarballTitle}</p>
              <div class="mt-3"><CodeBlock label="terminal" code={`tar xzf DegenView-${T}-linux-x64.tar.gz\n./degenview`} /></div>
              <p class="mt-4 text-sm text-muted">{t.install.linux.launcherIntro}</p>
              <div class="mt-3"><CodeBlock label="launcher" code={`install -Dm755 degenview "$HOME/.local/bin/degenview"\ninstall -Dm644 degenview.png "$HOME/.local/share/icons/hicolor/512x512/apps/degenview.png"\ninstall -Dm644 degenview.desktop "$HOME/.local/share/applications/degenview.desktop"`} /></div>
              <p class="mt-4 text-sm text-muted">{t.install.linux.tarballNote}</p>
            </div>
            <div class="min-w-0">
              <p class="mono-label">{t.install.linux.flatpakTitle}</p>
              <div class="mt-3"><CodeBlock label="flatpak" code={`flatpak remote-add --if-not-exists degenview https://flatpak.degenview.app/degenview.flatpakrepo\nflatpak install degenview es.nico.degenview//${flatpakBranch}\nflatpak run es.nico.degenview`} /></div>
              <p class="mt-4 text-sm text-muted" set:html={t.install.linux.flatpakNote} />
              <p class="mt-3 text-sm text-muted" set:html={fmt(t.install.linux.singleFile, { version: Th })} />
              <p class="mt-3 text-sm text-muted" set:html={t.install.linux.requirements} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verify -->
  <section id="verify" aria-labelledby="verify-h" class="py-16 sm:py-24">
    <div class="container-x">
      <SectionHead id="verify-h" align="left" eyebrow={t.verify.eyebrow} title={t.verify.title} lead={t.verify.lead} />

      <div class="glass mt-10 p-6 sm:mt-12 sm:p-8 lg:p-10" data-reveal="fade">
        <div class="grid gap-6 md:grid-cols-2">
          <div class="min-w-0">
            <p class="mono-label mb-3">{t.verify.macLinux}</p>
            <CodeBlock label="terminal" code={`shasum -a 256 DegenView-${T}-macos-arm64.dmg\n# or, on Linux\nsha256sum DegenView-${T}-linux-x64.tar.gz`} />
          </div>
          <div class="min-w-0">
            <p class="mono-label mb-3">{t.verify.windows}</p>
            <CodeBlock label="powershell" code={`Get-FileHash .\\DegenView-${T}-windows-x64-setup.exe -Algorithm SHA256`} />
          </div>
        </div>

        <div class="mt-6" data-dl-static>
          {
            checksums.length > 0 ? (
              <div class="space-y-3">
                {checksums.map((g) => (
                  <details class="group rounded-xl border border-[var(--hair)] bg-[var(--tile)]">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold transition-colors hover:bg-[var(--tile)] [&::-webkit-details-marker]:hidden">
                      <span class="flex items-center gap-3"><PlatformIcon os={g.os} class="size-5" />{fmt(t.verify.osChecksums, { os: g.os })}</span>
                      <svg viewBox="0 0 24 24" class="size-4 text-muted transition-transform group-open:rotate-45 group-open:text-accent-text" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    </summary>
                    <ul class="divide-y divide-[var(--hair)] border-t border-[var(--hair)]">
                      {g.rows.map((r) => (
                        <li class="flex flex-col gap-2 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
                          <div class="min-w-0">
                            <p class="mono-label truncate normal-case tracking-normal">{r.name}</p>
                            <p class="mt-1 break-all font-mono text-[13px] text-fg">{r.sha}</p>
                          </div>
                          <button type="button" data-copy={r.sha} class="shrink-0 self-start rounded-md border border-[var(--hair)] px-4 py-2.5 font-mono text-[0.68rem] font-medium uppercase tracking-[0.12em] text-muted transition-colors hover:border-[var(--hair-hi)] hover:text-fg sm:self-center" aria-label={fmt(t.verify.copyAria, { name: r.name })}>{t.verify.copy}</button>
                        </li>
                      ))}
                    </ul>
                  </details>
                ))}
              </div>
            ) : (
              <p class="text-sm text-muted" set:html={fmt(t.verify.listedOn, { url: release.htmlUrl })} />
            )
          }
        </div>
        <p class="mt-6 hidden text-sm text-muted" data-dl-stale set:html={fmt(t.verify.stale, { url: RELEASES_URL })} />
      </div>
    </div>
  </section>

  <!-- Release + source -->
  <section aria-labelledby="rel-h" class="py-16 sm:py-24">
    <div class="container-x">
      <SectionHead id="rel-h" align="left" eyebrow={t.release.eyebrow} title={t.release.title} />

      <div class="mt-10 grid gap-4 sm:mt-12 sm:gap-6 lg:grid-cols-2">
        {
          tag && (
            <div class="glass flex min-w-0 flex-col p-6 sm:p-8 lg:p-10" data-reveal>
              <div class="flex items-center justify-between gap-3">
                <span class="card-index">01</span>
                {status && <span class:list={['tag', statusKey === 'stable' ? '!text-up' : '!text-[#f5a524]']}>{status}</span>}
              </div>
              <h3 class="display mt-6 text-3xl sm:text-4xl">{t.release.thisRelease.title}</h3>
              <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2">
                <span class="fact-key !text-sm">{tag}</span>
                {published && <span class="mono-label">{published}</span>}
              </p>
              <p class="mt-4 text-muted">{statusKey === 'stable' ? '' : t.release.thisRelease.roughEdges[statusKey!] + ' '}{t.release.thisRelease.notes}</p>
              <div class="mt-6">
                <a href={release.htmlUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">{t.release.thisRelease.link}<span class="sr-only">{sr}</span></a>
              </div>
              {release.previous.length > 0 && (
                <div class="mt-6 border-t border-[var(--hair)] pt-5">
                  <p class="mono-label">{t.release.thisRelease.previous}</p>
                  <ul class="mt-2 divide-y divide-[var(--hair)] text-sm">
                    {release.previous.map((r) => (
                      <li>
                        <a href={r.url} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between gap-4 py-2.5 text-muted transition-colors hover:text-fg">
                          <span class="font-mono text-fg">{r.tag}</span>
                          <span class="font-mono text-xs">{date(r.published) ?? ''}</span>
                          <span class="sr-only">{sr}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )
        }

        <div class:list={['glass flex min-w-0 flex-col p-6 sm:p-8 lg:p-10', !tag && 'lg:col-span-2 lg:mx-auto lg:w-full lg:max-w-2xl']} data-reveal style="--i:1">
          <div class="flex items-center justify-between gap-3">
            <span class="card-index">{tag ? '02' : '01'}</span>
            <span class="tag">GPL-3.0</span>
          </div>
          <h3 class="display mt-6 text-3xl sm:text-4xl">{t.release.source.title}</h3>
          <p class="mt-4 text-muted">{t.release.source.lead}</p>
          <div class="mt-5"><CodeBlock label="terminal" code={`git clone ${REPO_URL}.git\ncd degenview\ncargo build --release`} /></div>
          <p class="mt-4 text-sm text-muted" set:html={t.release.source.note} />
          <div class="mt-auto pt-6">
            <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost"><PlatformIcon os="GitHub" class="size-5" />{t.release.source.github}<span class="sr-only">{sr}</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <div hidden data-copy-labels data-copied={t.verify.copied} data-copy-failed={t.verify.copyFailed}></div>

  <script>
    // Copy buttons for commands and checksums.
    document.addEventListener('click', async (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
      if (!btn) return;
      const original = btn.textContent;
      const labels = document.querySelector<HTMLElement>('[data-copy-labels]');
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        btn.textContent = labels?.dataset.copied ?? 'Copied';
      } catch {
        btn.textContent = labels?.dataset.copyFailed ?? 'Press ⌘/Ctrl+C';
      }
      setTimeout(() => (btn.textContent = original), 1800);
    });
  </script>

  <style>
    /* The visitor's own OS gets an accent outline (set by src/scripts/platform.ts). Plain CSS: .card/.glass paint their own border. */
    .os-card[data-selected] { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent), 0 20px 50px -30px var(--accent); }
    .os-row[data-selected] .os-title { color: var(--accent-text); }
  </style>
</Base>
