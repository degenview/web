---
import { getStaticPaths as paths } from '../../i18n/paths';
export const getStaticPaths = paths;
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import TopicNav from '../../components/TopicNav.astro';
import { getFaq, getFaqGroups } from '../../data/faq';
import { getArt } from '../../data/illustrations';
import { REPO_URL } from '../../data/platforms';
import { fmt, getLang, localeMeta, localePath, useT } from '../../i18n';

const lang = getLang(Astro.url);
const t = useT(lang).faq;
const art = getArt(lang);
const faq = getFaq(lang);
const faqGroups = getFaqGroups(lang);
const sr = ' ' + useT(lang).common.opensInNewTab;
const issuesUrl = `${REPO_URL}/issues`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: localeMeta[lang].htmlLang,
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const groups = faqGroups.map((g) => ({ ...g, items: faq.filter((f) => f.group === g.id) }));
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path="/faq/"
  jsonLd={jsonLd}
  breadcrumbs={[[t.breadcrumbs.home, '/'], [t.breadcrumbs.faq, '/faq/']]}
>
  <Header slot="header" />

  <PageHero eyebrow={t.hero.eyebrow} title={t.hero.title} lead={t.hero.lead} align="left">
    <form role="search" class="mt-8 max-w-xl" data-faq-search data-found={JSON.stringify(t.hero.found)} hidden onsubmit="return false">
      <label for="faq-q" class="sr-only">{t.hero.searchLabel}</label>
      <div class="relative">
        <svg viewBox="0 0 24 24" class="pointer-events-none absolute left-4 top-1/2 z-10 size-5 -translate-y-1/2 text-muted" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.500-3.500" /></svg>
        <input id="faq-q" type="search" autocomplete="off" placeholder={fmt(t.hero.searchPlaceholder, { count: faq.length })} class="w-full rounded-xl border border-[var(--hair)] bg-[var(--panel)] py-3.5 pl-12 pr-5 text-base outline-none transition-colors placeholder:text-muted focus:border-[var(--hair-hi)]" />
      </div>
      <p class="mono-label mt-3 min-h-4" aria-live="polite" data-faq-count></p>
    </form>
  </PageHero>

  <div class="container-x grid grid-cols-[minmax(0,1fr)] gap-6 pb-16 pt-10 sm:pb-24 sm:pt-12 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-10">
    <TopicNav label={t.nav.label} heading={t.nav.heading} items={groups.map((g) => ({ id: g.id, title: g.title, count: g.items.length }))} />

    <div class="min-w-0 space-y-4 sm:space-y-6">
      {
        groups.map((g, gi) => (
          <section id={g.id} aria-labelledby={`${g.id}-h`} data-faq-group data-reveal="fade" class="glass scroll-mt-24 p-6 sm:p-8 lg:p-10">
            <div class:list={['grid gap-6', g.art && 'md:grid-cols-[minmax(0,1fr)_14rem] md:items-center']}>
              <div>
                <span class="card-index">{String(gi + 1).padStart(2, '0')}</span>
                <h2 id={`${g.id}-h`} class="display mt-4 text-4xl sm:text-5xl">{g.title}</h2>
                <p class="mt-3 text-lg text-muted">{g.intro}</p>
              </div>
              {g.art && (
                <div class="relative aspect-[16/10] w-full overflow-hidden rounded-xl border border-[var(--hair)] bg-bg/50">
                  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,var(--glow-a),transparent_70%)]"></div>
                  <svg viewBox="0 0 320 200" class="absolute inset-0 size-full" role="img" aria-label={fmt(t.groupArtLabel, { title: g.title })} set:html={art[g.art]} />
                </div>
              )}
            </div>

            <div class="mt-6 divide-y divide-[var(--hair)] border-t border-[var(--hair)] sm:mt-8">
              {
                g.items.map((f, fi) => (
                  <details id={f.id} data-faq-item data-text={`${f.q} ${f.a}`.toLowerCase()} class="group scroll-mt-28">
                    <summary class="flex cursor-pointer list-none items-baseline gap-4 py-4 text-base font-semibold transition-colors hover:text-accent-text sm:py-5 sm:text-lg [&::-webkit-details-marker]:hidden">
                      <span class="card-index shrink-0">{String(fi + 1).padStart(2, '0')}</span>
                      <span class="min-w-0 flex-1">{f.q}</span>
                      <svg viewBox="0 0 24 24" class="size-4 shrink-0 translate-y-0.5 self-center text-muted transition-transform group-open:rotate-45 group-open:text-accent-text" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    </summary>
                    <div class:list={['pb-5 sm:pb-6 sm:pl-9', f.art && 'grid gap-5 md:grid-cols-[minmax(0,1fr)_14rem] md:items-center']}>
                      <div>
                        <p class="text-muted sm:text-lg">{f.a}</p>
                        {f.links && (
                          <p class="mt-3 flex flex-wrap gap-x-6 gap-y-1 font-mono text-xs font-medium uppercase tracking-[0.12em]">
                            {f.links.map(([label, href]) => (
                              <a class="inline-flex items-center gap-1.5 py-2 text-accent-text hover:underline" href={href}>
                                {label}
                                <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
                              </a>
                            ))}
                          </p>
                        )}
                      </div>
                      {f.art && (
                        <div class="relative aspect-[16/10] overflow-hidden rounded-xl border border-[var(--hair)] bg-bg/50">
                          <svg viewBox="0 0 320 200" class="absolute inset-0 size-full" role="img" aria-label={fmt(t.itemArtLabel, { question: f.q })} set:html={art[f.art]} />
                        </div>
                      )}
                    </div>
                  </details>
                ))
              }
            </div>
          </section>
        ))
      }

      <p class="glass hidden p-6 text-center text-muted sm:p-8 lg:p-10" data-faq-empty set:html={fmt(t.empty, { url: issuesUrl })} />
    </div>
  </div>

  <!-- Still stuck -->
  <section class="pb-16 sm:pb-24">
    <div class="container-x">
      <div class="glass stage relative mx-auto max-w-4xl" data-reveal="scale">
        <span class="glow-line absolute inset-x-10 top-0" aria-hidden="true"></span>
        <div class="p-6 text-center sm:p-8 lg:p-10">
          <p class="kicker kicker-c">{useT(lang).common.nav.faq}</p>
          <h2 class="display mt-4 text-5xl sm:text-6xl" set:html={t.cta.title} />
          <p class="mx-auto mt-5 max-w-xl text-lg text-muted">{t.cta.lead}</p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a href={localePath(lang, '/download/')} class="btn btn-gradient px-7 py-3.5">{t.cta.download}</a>
            <a href={issuesUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost px-7 py-3.5">{t.cta.ask}<span class="sr-only">{sr}</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-faq-search]');
    const input = document.getElementById('faq-q') as HTMLInputElement | null;
    const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]')];
    const groups = [...document.querySelectorAll<HTMLElement>('[data-faq-group]')];
    const empty = document.querySelector<HTMLElement>('[data-faq-empty]');
    const count = document.querySelector<HTMLElement>('[data-faq-count]');
    // Result-count strings by plural category, from the page's dictionary.
    const found: Record<string, string> = JSON.parse(form?.dataset.found ?? '{}');
    const plural = new Intl.PluralRules(document.documentElement.lang);

    // Search: shown only with JavaScript. Matches open, the rest hide, empty topics hide with them.
    if (form && input) {
      form.hidden = false;
      const run = () => {
        const q = input.value.trim().toLowerCase();
        const terms = q.split(/\s+/).filter(Boolean);
        let shown = 0;
        for (const it of items) {
          const hit = terms.every((t) => it.dataset.text!.includes(t));
          it.hidden = !hit;
          if (hit) shown++;
          if (q) it.open = hit;
        }
        if (!q) items.forEach((it) => (it.open = false));
        for (const g of groups) g.hidden = ![...g.querySelectorAll('[data-faq-item]')].some((el) => !(el as HTMLElement).hidden);
        empty?.classList.toggle('hidden', shown > 0);
        if (count) count.textContent = q ? (found[plural.select(shown)] ?? found.other).replace('{count}', String(shown)) : '';
      };
      input.addEventListener('input', run);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && input.value) { input.value = ''; run(); }
      });
    }

    // Deep links: #question-slug opens that answer, and opening one puts its link in the address bar.
    const openFromHash = () => {
      const el = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
      if (el instanceof HTMLDetailsElement) { el.open = true; el.scrollIntoView({ block: 'start' }); }
    };
    items.forEach((it) => it.addEventListener('toggle', () => { if (it.open && !input?.value) history.replaceState(null, '', `#${it.id}`); }));
    openFromHash();
    addEventListener('hashchange', openFromHash);
  </script>
</Base>
