---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NotPremium from '../components/NotPremium.astro';
import DownloadButton from '../components/DownloadButton.astro';

const description =
  'Multiple watchlists, multi-chart layouts, indicators, alerts, bar replay, scripting and portfolio tracking. Everything other dashboards call premium is free in DegenView.';
---

<Base title="Why DegenView Is Free – No Premium Tier" description={description} path="/why-free/">
  <Header slot="header" />
  <div class="container-x py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-mono text-sm font-semibold text-accent-text">the paywall-free zone</p>
      <h1 class="mt-3 text-balance text-4xl font-extrabold tracking-tight sm:text-6xl">Nothing here is a “premium feature”.</h1>
      <p class="mt-4 text-lg text-muted">Other dashboards slice the basics into tiers. We just shipped them.</p>
    </div>
    <div class="mt-14"><NotPremium /></div>
    <div class="mt-16 flex flex-col items-center gap-3 text-center">
      <p class="text-lg font-semibold">Free, open source, and no account.</p>
      <DownloadButton showNote />
    </div>
  </div>
  <Footer slot="footer" />
</Base>
