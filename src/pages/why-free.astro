---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NotPremium from '../components/NotPremium.astro';
import DownloadButton from '../components/DownloadButton.astro';

const description =
  'A free, open source TradingView alternative with no premium tier: unlimited watchlists, multi-chart layouts, indicators, alerts, replay and scripting.';

const manifesto: [string, string][] = [
  ['Free and open source.', 'No tiers, no trial clock, no “upgrade to unlock”. The source is public under the GPL-3.0, so you can read it, build it and change it.'],
  ['No SaaS for the basics.', 'Charts, watchlists, indicators, alerts, replay and Pine Script run on your machine. You shouldn’t need a subscription, or someone else’s server, for the basics.'],
  ['Private by default.', 'No analytics, no telemetry, no account. Your watchlists, portfolios and scripts stay on your device. Anything that leaves it, like iCloud sync or a webhook, is something you switch on yourself.'],
];
---

<Base
  title="Why DegenView Is Free – No Premium Tier, Open Source"
  description={description}
  path="/why-free/"
  breadcrumbs={[['Home', '/'], ['Why free', '/why-free/']]}
>
  <Header slot="header" />
  <div class="container-x py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-accent-text">the paywall-free zone</p>
      <h1 class="display mt-3 text-5xl sm:text-7xl">Nothing here is a <span class="gradient-text block">“premium feature”.</span></h1>
      <p class="mt-4 text-lg text-muted">Other dashboards slice the basics into tiers. We just shipped them.</p>
    </div>
    <section aria-labelledby="manifesto-h" class="mx-auto mt-20 max-w-3xl">
      <p class="text-center text-sm font-semibold text-accent-text">the manifesto</p>
      <h2 id="manifesto-h" class="display mt-3 text-center text-3xl sm:text-5xl">Three things <span class="gradient-text">we believe</span></h2>
      <ol class="mt-12 divide-y divide-line/60 border-y border-line/60">
        {
          manifesto.map(([t, d], i) => (
            <li class="flex gap-5 py-7 sm:gap-8 sm:py-8">
              <span class="pt-1 font-mono text-sm text-accent-text">0{i + 1}</span>
              <div>
                <h3 class="display text-3xl sm:text-4xl">{t}</h3>
                <p class="mt-3 text-lg text-muted sm:text-xl">{d}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="display mt-10 text-center text-2xl sm:text-4xl">Free, local, and <span class="gradient-text">none of anyone’s business.</span></p>
    </section>

    <div class="mt-24 text-center">
      <p class="text-sm font-semibold text-accent-text">the receipts</p>
      <h2 class="display mt-3 text-3xl sm:text-5xl">Free here, <span class="gradient-text">premium elsewhere</span></h2>
    </div>
    <div class="mt-10"><NotPremium /></div>
    <div class="mt-16 flex flex-col items-center gap-3 text-center">
      <p class="text-lg font-semibold">Free, open source, and no account.</p>
      <p class="text-muted">Weighing it against TradingView? <a class="text-accent-text underline underline-offset-4" href="/tradingview-alternative/">See the comparison</a>.</p>
      <DownloadButton showNote />
    </div>
  </div>
  <Footer slot="footer" />
</Base>
